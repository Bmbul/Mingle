@page "/facts"
@inject Text T
@inject FactSession Session

<PageTitle>@T[$"Facts_{Session.Kind}"] · Mingle</PageTitle>

@if (Session.Game is not { } game)
{
    <main class="main center-screen">
        <p class="muted">@T["Handoff_NotStarted"]</p>
        <a class="btn" href="setup">@T["Home_NewGame"]</a>
    </main>
}
else if (game.Stage == FactStage.Writing && Session.NextWriter is { } writer)
{
    @if (writing != writer.Id)
    {
        @* The phone goes round: everyone writes in secret. *@
        <main class="main center-screen">
            <p class="muted">@T["Facts_PassTo"]</p>
            <p class="blitz-name">@writer.Name</p>
            <p class="muted center"><Icon Name="secret" Size="18" /> @T["Facts_WriteSecretly"]</p>
            <p class="muted small">@T["Facts_Written", game.WrittenIds.Length, Session.Players.Length]</p>
        </main>
        <footer class="foot">
            <button class="btn" @onclick="() => writing = writer.Id">@T["Facts_ImReady", writer.Name]</button>
        </footer>
    }
    else
    {
        <header class="top">
            <h1 class="h1">@writer.Name</h1>
        </header>
        <main class="main">
            <FactWriter @key="@($"{writer.Id}-{promptVersion}")" Kind="Session.Kind" FindTheLie="Session.FindTheLie"
                        FactsEach="Session.Settings.FactsEach" Lang="writer.Lang"
                        Prompts="@([.. game.PromptsFor(writer.Id).Select(id => game.PromptText(id, writer.Lang) ?? "")])"
                        CanSwap="@(Session.Kind != FactGameKind.WhoseFact)" OnSwap="() => game.SwapPrompt(writer.Id)" OnDone="r => Write(writer, r)" />
        </main>
    }
}
else if (game.Stage is FactStage.Showing or FactStage.Revealed && game.Current is { } item)
{
    var revealed = game.Stage == FactStage.Revealed;
    var last = game.Index + 1 >= game.Items.Count;
    <header class="top spread">
        <span class="muted">@T["Facts_ItemOf", game.Index + 1, game.Items.Count]</span>
        <button class="text-btn" @onclick="game.End">@T["Play_End"]</button>
    </header>
    <main class="main">
        @* Once the answer is out (or with authors kept for the end), swipe the card to go on. *@
        <SwipeCard OnSwipe="@(CanGoOn(game) ? EventCallback.Factory.Create(this, game.Next) : default)" Last="@last">
            <div class="card-face swipe-panel">
                @if (Session.OneTruth)
                {
                    var author = Session.PlayerById(item.AuthorId);
                    <p class="label">@T["Facts_FactsOf"]</p>
                    <h1 class="h1 big">@author.Name</h1>
                    @if (game.PromptText(item.PromptId, Text.UiLang) is { } prompt)
                    {
                        <p class="muted">@prompt</p>
                    }
                    <FactList Texts="item.Texts" FindTheLie="Session.FindTheLie" Answer="@(revealed ? item.Marked.ToString() : null)" />
                    @if (!revealed)
                    {
                        <div class="talk">
                            <p class="h2">@T[Session.FindTheLie ? "Facts_DiscussLie" : "Facts_DiscussTruth"]</p>
                            <p class="muted small">@T["Facts_DiscussHint", author.Name]</p>
                        </div>
                    }
                }
                else if (Session.Kind == FactGameKind.TrueOrFalse)
                {
                    var author = Session.PlayerById(item.AuthorId);
                    <p class="label">@T["Facts_FactOf"]</p>
                    <h1 class="h1 big">@author.Name</h1>
                    @if (game.PromptText(item.PromptId, Text.UiLang) is { } prompt)
                    {
                        <p class="muted">@prompt</p>
                    }
                    <div class="card fact-big"><span>@item.Texts[0]</span></div>
                    @if (revealed)
                    {
                        <p class="handoff-verdict right center">@T[item.Marked == 1 ? "Facts_ItWasTrue" : "Facts_ItWasMadeUp"]</p>
                    }
                    else
                    {
                        <div class="talk">
                            <p class="h2">@T["Facts_TrueOrMadeUp"]</p>
                            <p class="muted small">@T["Facts_DiscussHint", author.Name]</p>
                        </div>
                    }
                }
                else
                {
                    @if (game.PromptText(item.PromptId, Text.UiLang) is { } prompt)
                    {
                        <p class="label">@prompt</p>
                    }
                    <div class="card fact-big"><span>@item.Texts[0]</span></div>
                    @if (revealed)
                    {
                        <p class="h2 center">@T["Facts_WrittenBy", Session.PlayerById(item.AuthorId).Name]</p>
                    }
                    else
                    {
                        <div class="talk">
                            <p class="h2">@T["Facts_WhoWroteIt"]</p>
                            <p class="muted small">@T[Session.Settings.RevealEachFact ? "Facts_GuessAloud" : "Facts_GuessAloudKeep"]</p>
                        </div>
                    }
                }
            </div>
        </SwipeCard>
    </main>
    @if (!CanGoOn(game))
    {
        <footer class="foot">
            <button class="btn" @onclick="game.Reveal">@T["Facts_Reveal"]</button>
        </footer>
    }
}
else
{
    var recap = Session.Kind != FactGameKind.WhoseFact ? [] : game.ForPlayer(Session.Players[0].Id, Text.UiLang).Recap;
    <main class="main @(recap.IsEmpty ? "center-screen" : "")">
        <h1 class="h1 big">@T["Facts_AllDone"]</h1>
        @if (!recap.IsEmpty)
        {
            <h2 class="label">@T["Facts_Recap"]</h2>
            @foreach (var fact in recap)
            {
                <div class="card">
                    <span class="row-title">@fact.Text</span>
                    <span class="muted small">@Session.PlayerById(fact.AuthorId).Name</span>
                </div>
            }
        }
        <p class="muted">@T["Facts_AllDoneHint"]</p>
    </main>
    <footer class="foot">
        <button class="btn" @onclick="Again">@T["Handoff_Again"]</button>
        <a class="btn2" href="">@T["End_Home"]</a>
    </footer>
}

@code {
    /// <summary>The player who said they have the phone and is writing now.</summary>
    private string? writing;
    private int promptVersion;

    private void Write(Player writer, (ImmutableArray<string> Texts, int Marked) facts)
    {
        Session.Game!.Write(writer.Id, facts.Texts, facts.Marked);
        writing = null;
        promptVersion++;
    }

    private void Again()
    {
        Session.Restart();
        writing = null;
    }

    /// <summary>The answer is out (or Whose fact keeps the authors for the end): a swipe goes on.</summary>
    private bool CanGoOn(FactGame game) => game.Stage == FactStage.Revealed || !Session.Settings.RevealEachFact;
}
