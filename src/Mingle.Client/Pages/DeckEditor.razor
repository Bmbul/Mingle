@page "/decks/new"
@page "/decks/{Id}/edit"
@inject Text T
@inject ContentService Content
@inject DeviceDeckStore DeviceDecks
@inject NavigationManager Nav

<PageTitle>@Title · Mingle</PageTitle>

<header class="top">
    <a class="icon" href="decks" aria-label="@T["Common_Back"]"><Icon Name="back" /></a>
    <h1 class="h1">@Title</h1>
</header>

<main class="main">
    @if (loading)
    {
        <p class="muted center">@T["Online_Connecting"]</p>
    }
    else if (notAllowed)
    {
        <p class="muted">@T["Editor_NoKey"]</p>
    }
    else
    {
        <section class="stack">
            <label class="label" for="deck-name">@T["Editor_Name"]</label>
            <input id="deck-name" class="field" maxlength="60" autocomplete="off" placeholder="@T["Editor_NamePlaceholder"]"
                   @bind="name" @bind:event="oninput" />
        </section>

        @* Which game the deck is for; fixed once it has cards, since a deck holds one game's cards only. *@
        <section class="stack">
            <h2 class="label">@T["Editor_Game"]</h2>
            @if (cards.Count == 0)
            {
                <div class="chips" role="group" aria-label="@T["Editor_Game"]">
                    @foreach (var option in Enum.GetValues<DeckStyle>())
                    {
                        var o = option;
                        <button class="chip @(chosenStyle == o ? "on" : "")" aria-pressed="@(chosenStyle == o ? "true" : "false")"
                                @onclick="() => chosenStyle = o">@T[$"Editor_Game_{o}"]</button>
                    }
                </div>
            }
            else
            {
                <p class="muted small">@T[$"Editor_Game_{Style}"] · @T["Editor_GameFixed"]</p>
            }
        </section>

        <section class="stack">
            <h2 class="label">@T.Plural("Cards", cards.Count)</h2>
            @foreach (var card in cards)
            {
                var c = card;
                if (ReferenceEquals(open, c))
                {
                    <div class="card stack">
                        <div class="row gap">
                            <label class="visually-hidden" for="kind-@c.Key">@T["Editor_Kind"]</label>
                            <select id="kind-@c.Key" class="field grow" @bind="c.KindId">
                                @foreach (var kind in KindsFor(c))
                                {
                                    <option value="@kind.Id">@T.KindName(kind.Id)</option>
                                }
                            </select>
                        </div>
                        <div class="chips" role="group" aria-label="@T["Editor_Depth"]">
                            @for (var depth = 1; depth <= 3; depth++)
                            {
                                var d = depth;
                                <button class="chip @(c.Depth == d ? "on" : "")" aria-pressed="@(c.Depth == d ? "true" : "false")"
                                        @onclick="() => c.Depth = d">@T[$"Depth_{d}"]</button>
                            }
                        </div>
                        @foreach (var lang in EditOrder)
                        {
                            var l = lang;
                            <div class="stack">
                                <span class="label" lang="@l.Code()">@Text.LangName(l)</span>
                                @if (c.IsChoice)
                                {
                                    <input class="field" lang="@l.Code()" maxlength="120" placeholder="@T["Editor_OptionA"]"
                                           value="@c.Option(l, 0)" @oninput="e => c.SetOption(l, 0, e.Value as string)" />
                                    <input class="field" lang="@l.Code()" maxlength="120" placeholder="@T["Editor_OptionB"]"
                                           value="@c.Option(l, 1)" @oninput="e => c.SetOption(l, 1, e.Value as string)" />
                                }
                                else
                                {
                                    <textarea class="field area" lang="@l.Code()" maxlength="300" placeholder="@T[$"Editor_Hint_{c.KindId}"]"
                                              value="@c.Text(l)" @oninput="e => c.SetText(l, e.Value as string)"></textarea>
                                }
                            </div>
                        }
                        <p class="muted small">@T["Editor_LangHint"]</p>
                        <div class="row gap">
                            <button class="btn2 grow" @onclick="() => Remove(c)">@T["Editor_RemoveCard"]</button>
                            <button class="btn grow" @onclick="() => open = null">@T["Editor_Done"]</button>
                        </div>
                    </div>
                }
                else
                {
                    @* Swipe left to remove (js/swipe.js); the hidden button keeps it reachable by keyboard and screen readers. *@
                    <div class="swipe-row" @key="c.Key">
                        <span class="swipe-bg" aria-hidden="true"><Icon Name="close" Size="18" />@T["Editor_RemoveCard"]</span>
                        <button class="check-row swipe-content @(c.IsComplete ? "" : "incomplete")" @onclick="() => open = c">
                            <span class="grow">
                                <span class="row-title">@(c.Preview(Text.UiLang) is { Length: > 0 } p ? p : T["Editor_EmptyCard"])</span>
                                <span class="muted small">@T.KindName(c.KindId) · @T[$"Depth_{c.Depth}"] · @string.Join(" ", c.Languages.Select(l => l.Code().ToUpperInvariant()))</span>
                            </span>
                        </button>
                        <button class="visually-hidden" data-swipe-remove @onclick="() => Remove(c)">@T["Editor_RemoveCard"]</button>
                    </div>
                }
            }
            @if (cards.Count == 0)
            {
                <p class="muted">@T["Editor_NoCardsYet"]</p>
            }
            @if (removed is { } last)
            {
                <div class="undo-bar" role="status">
                    <span class="grow">@T["Editor_Removed"]</span>
                    <button class="text-btn" @onclick="Undo">@T["Editor_Undo"]</button>
                </div>
            }
        </section>

        <section class="add-row" aria-label="@T["Editor_AddCards"]">
            <button class="btn2" @onclick="AddCard"><Icon Name="plus" Size="18" />@T["Editor_WriteCard"]</button>
            <button class="btn2" @onclick="@(() => OpenSheet("generate"))"><Icon Name="refresh" Size="18" />@T["Editor_Generate"]</button>
            <button class="btn2" @onclick="@(() => OpenSheet("decks"))"><Icon Name="layers" Size="18" />@T["Editor_FromDecks"]</button>
        </section>
        @if (addedNote is not null)
        {
            <p class="muted small" role="status">@addedNote</p>
        }

    }
</main>

@if (!loading && !notAllowed)
{
    <footer class="foot">
        <p class="muted center" role="status">@Status</p>
        <button class="btn" disabled="@(!CanSave || busy)" @onclick="Save">@T["Editor_Save"]</button>
    </footer>
}

@if (sheet is not null && !loading && !notAllowed)
{
    <div class="sheet-backdrop" @onclick="CloseSheet"></div>
    <div class="sheet tall" role="dialog" aria-modal="true" aria-labelledby="sheet-title">
        <div class="row gap">
            <h2 id="sheet-title" class="h2 grow">@(sheet == "generate" ? T["Editor_Generate"] : T["Editor_FromDecks"])</h2>
            <button class="icon" aria-label="@T["End_Close"]" @onclick="CloseSheet"><Icon Name="close" /></button>
        </div>
        @if (sheet == "generate")
        {
        @if (Style == DeckStyle.Handoff)
        {
        @* "Give it to…" cards are about the people in the room: moods instead of topics and depth. *@
        <section class="stack">
            <h2 class="label">@T["Editor_AiMood"]</h2>
            <div class="chips" role="group" aria-label="@T["Editor_AiMood"]">
                @foreach (var option in Moods)
                {
                    var m = option;
                    var on = moods.Contains(m);
                    <button class="chip @(on ? "on" : "")" aria-pressed="@(on ? "true" : "false")" disabled="@(writing || (on && moods.Count == 1))"
                            @onclick="() => { if (!moods.Remove(m)) moods.Add(m); }">@T[$"Editor_Mood_{m}"]</button>
                }
            </div>
            <p class="muted small">@T[BoldAllowed ? "Editor_MoodHint" : "Editor_MoodBoldHint"]</p>
        </section>

        <section class="stack">
            <label class="label" for="ai-group">@T["Editor_AiGroup"]</label>
            <textarea id="ai-group" class="field area" maxlength="200"
                      @bind="theme" @bind:event="oninput" disabled="@writing"></textarea>
        </section>
        }
        else
        {

        <section class="stack">
            <h2 class="label">@T["Editor_AiTopics", CardLimits.MaxTopics]</h2>
            @* One page per group; swipe sideways or tap a dot (js/swipe.js keeps the dots in step). *@
            <div class="pager" role="group" aria-label="@T["Editor_AiTopics", CardLimits.MaxTopics]">
                <div class="pager-tabs" role="tablist">
                    @for (var i = 0; i < TopicPages.Count; i++)
                    {
                        <button class="pager-tab @(i == 0 ? "on" : "")" role="tab" data-page="@i">@T[$"TopicGroup_{TopicPages[i].Group}"]</button>
                    }
                </div>
                <div class="pager-pages">
                    @foreach (var (group, members) in TopicPages)
                    {
                        <div class="pager-page" role="tabpanel" aria-label="@T[$"TopicGroup_{group}"]">
                            <div class="chips">
                                @foreach (var topic in members)
                                {
                                    var code = topic.Code;
                                    var on = pickedTopics.Contains(code);
                                    <button class="chip @(on ? "on" : "")" aria-pressed="@(on ? "true" : "false")"
                                            disabled="@(writing || (!on && pickedTopics.Count >= CardLimits.MaxTopics))"
                                            @onclick="() => ToggleTopic(code)">@topic.NameFor(Text.UiLang)</button>
                                }
                            </div>
                        </div>
                    }
                </div>
                <div class="pager-dots">
                    @for (var i = 0; i < TopicPages.Count; i++)
                    {
                        <button class="pager-dot @(i == 0 ? "on" : "")" data-page="@i" aria-hidden="true" tabindex="-1"></button>
                    }
                </div>
            </div>
        </section>

        <section class="stack">
            <label class="label" for="ai-theme">@T["Editor_AiOwn"]</label>
            <textarea id="ai-theme" class="field area" maxlength="200" placeholder="@T["Editor_AiPlaceholder"]"
                      @bind="theme" @bind:event="oninput" disabled="@writing"></textarea>
        </section>

        <section class="stack">
            <h2 class="label">@T["Editor_AiDepth"]</h2>
            <div class="chips" role="group" aria-label="@T["Editor_AiDepth"]">
                @for (var level = 1; level <= 3; level++)
                {
                    var d = level;
                    var on = depths.Contains(d);
                    @* At least one depth stays on. *@
                    <button class="chip @(on ? "on" : "")" aria-pressed="@(on ? "true" : "false")" disabled="@(writing || (on && depths.Count == 1))"
                            @onclick="() => { if (!depths.Remove(d)) depths.Add(d); }">@T[$"Depth_{d}"]</button>
                }
            </div>
        </section>

        }

        <section class="stack">
            <h2 class="label">@T["Editor_AiLanguages"]</h2>
            <div class="chips" role="group" aria-label="@T["Editor_AiLanguages"]">
                @foreach (var language in Langs.All)
                {
                    var l = language;
                    var on = languages.Contains(l);
                    <button class="chip @(on ? "on" : "")" aria-pressed="@(on ? "true" : "false")" lang="@l.Code()"
                            disabled="@(writing || (on && languages.Count == 1))"
                            @onclick="() => { if (!languages.Remove(l)) languages.Add(l); }">@Text.LangName(l)</button>
                }
            </div>
            <p class="muted small">@T["Editor_AiLanguagesHint"]</p>
        </section>

        <section class="stack">
            <h2 class="label">@T["Editor_AiSetting"]</h2>
            <div class="chips" role="group" aria-label="@T["Editor_AiSetting"]">
                @foreach (var option in Settings)
                {
                    var s = option;
                    <button class="chip @(setting == s ? "on" : "")" aria-pressed="@(setting == s ? "true" : "false")" disabled="@writing"
                            @onclick="() => PickSetting(s)">@T[$"Editor_Setting_{s}"]</button>
                }
            </div>
        </section>

        <button class="btn2" disabled="@(writing || !CanWrite)" @onclick="WriteWithAi">
            @if (writing)
            {
                <span class="spinner small" aria-hidden="true"></span>@T["Editor_AiWriting"]
            }
            else
            {
                @T[cards.Any(c => c.IsComplete) ? "Editor_AiWriteMore" : "Editor_AiWrite", CardLimits.PerWrite]
            }
        </button>
        <p class="muted small" role="status">@(aiNote ?? T["Editor_AiHint"])</p>
        }
        else
        {
        <p class="muted small">@T["Editor_DecksHint"]</p>
        @if (sourceDecks.IsEmpty)
        {
            <p class="muted center">@T["Online_Connecting"]</p>
        }
        @foreach (var source in sourceDecks.Where(d => d.Style == Style))
        {
            var deck = source;
            var expanded = openDecks.Contains(deck.Id);
            var addable = deck.Cards.Where(c => !InDeck(c)).ToList();
            var allPicked = addable.Count > 0 && addable.All(c => picked.Contains(Key(deck, c)));
            <div class="card stack">
                <div class="row gap">
                    <button class="text-row grow" aria-expanded="@(expanded ? "true" : "false")"
                            @onclick="() => { if (!openDecks.Remove(deck.Id)) openDecks.Add(deck.Id); }">
                        <span class="row-title">@deck.NameFor(Text.UiLang)</span>
                        <span class="muted small">@T.Plural("Cards", deck.Cards.Length)</span>
                    </button>
                    <button class="chip @(allPicked ? "on" : "")" aria-pressed="@(allPicked ? "true" : "false")" disabled="@(addable.Count == 0)"
                            @onclick="() => PickAll(deck, addable, !allPicked)">@T["Editor_SelectAll"]</button>
                </div>
                @if (expanded)
                {
                    @foreach (var item in deck.Cards)
                    {
                        var card = item;
                        var key = Key(deck, card);
                        var already = InDeck(card);
                        var on = already || picked.Contains(key);
                        var text = card.TextFor(Text.UiLang);
                        <button class="check-row @(on ? "on" : "")" aria-pressed="@(on ? "true" : "false")" disabled="@already"
                                @onclick="() => { if (!picked.Remove(key)) picked.Add(key); }">
                            <span class="box @(on ? "on" : "")" aria-hidden="true">@if (on) { <Icon Name="check" Size="14" Stroke="3" /> }</span>
                            <span class="grow">
                                <span class="row-title">@(text.Options.IsEmpty ? text.Text : string.Join(" / ", text.Options))</span>
                                <span class="muted small">@(already ? T["Editor_AlreadyIn"] : $"{T.KindName(card.KindId)} · {T[$"Depth_{card.Depth}"]}")</span>
                            </span>
                        </button>
                    }
                }
            </div>
        }
        <button class="btn2" disabled="@(picked.Count == 0)" @onclick="AddPicked"><Icon Name="layers" Size="18" />@T["Editor_AddPicked", picked.Count]</button>
        }
    </div>
}

@code {
    [Parameter] public string? Id { get; set; }

    /// <summary>One card while it is edited: texts per language; "would you rather" has two options instead.</summary>
    private sealed class EditCard
    {
        private static int next;
        public int Key { get; } = ++next;
        public string Id { get; init; } = "";
        public string KindId { get; set; } = "open";
        public int Depth { get; set; } = 1;
        public Dictionary<Lang, string> Texts { get; } = [];
        public Dictionary<Lang, string[]> Options { get; } = [];

        public bool IsChoice => KindId == CardKinds.WouldYouRather.Id;
        public string Text(Lang l) => Texts.GetValueOrDefault(l, "");
        public void SetText(Lang l, string? v) => Texts[l] = v ?? "";
        public string Option(Lang l, int i) => Options.TryGetValue(l, out var o) ? o[i] : "";
        public void SetOption(Lang l, int i, string? v)
        {
            if (!Options.TryGetValue(l, out var o)) Options[l] = o = ["", ""];
            o[i] = v ?? "";
        }

        /// <summary>A language counts once its text (or both options) is filled in.</summary>
        public IEnumerable<Lang> Languages => Langs.All.Where(l => IsChoice
            ? Options.TryGetValue(l, out var o) && o.All(x => !string.IsNullOrWhiteSpace(x))
            : !string.IsNullOrWhiteSpace(Text(l)));

        public bool IsComplete => Languages.Any();

        public string Preview(Lang ui)
        {
            var lang = Languages.Contains(ui) ? ui : Languages.FirstOrDefault();
            if (!IsComplete) return "";
            return IsChoice ? string.Join(" / ", Options[lang]) : Text(lang);
        }

        public static EditCard From(Card card)
        {
            var edit = new EditCard { Id = card.Id, KindId = card.KindId, Depth = card.Depth };
            foreach (var (lang, text) in card.Texts)
            {
                edit.Texts[lang] = text.Text;
                if (text.Options.Length == 2) edit.Options[lang] = [text.Options[0], text.Options[1]];
            }
            return edit;
        }

        public Card ToCard(int position)
        {
            var texts = Languages.ToImmutableDictionary(l => l, l => IsChoice
                ? new CardText(WouldYouRather(l), [Options[l][0].Trim(), Options[l][1].Trim()])
                : new CardText(Text(l).Trim()));
            return new Card(Id.Length > 0 ? Id : $"new-{position}", KindId, Depth, [], texts);
        }

        private static string WouldYouRather(Lang l) => l switch
        {
            Lang.Hy => "Ո՞րն ես նախընտրում",
            Lang.Ru => "Что ты выберешь?",
            _ => "Would you rather…",
        };
    }

    private string Title => Id is null ? T["Decks_New"] : T["Editor_Title"];
    private Lang[] EditOrder => [Text.UiLang, .. Langs.All.Where(l => l != Text.UiLang)];

    private bool loading = true;
    private bool notAllowed;
    private bool busy;
    private string name = "";
    private string? editKey;
    private List<EditCard> cards = [];
    private EditCard? open;
    private string? error;
    private string? note;
    private string theme = "";
    private bool writing;
    private string? aiNote;
    private ImmutableArray<TopicInfo> topics = [];
    private readonly HashSet<string> pickedTopics = [];
    private readonly HashSet<int> depths = [1, 2, 3];
    private readonly HashSet<Lang> languages = [Text.UiLang];
    private string setting = "couple";
    /// <summary>The game picked for a new, still empty deck.</summary>
    private DeckStyle chosenStyle = DeckStyle.Questions;
    private string? sheet;
    private string? addedNote;

    private static readonly string[] Settings = ["couple", "friends", "family", "party", "colleagues"];

    // "Give it to…": moods instead of topics; "bold" only for groups where it fits (the server checks the same).
    private static readonly string[] BoldSettings = ["friends", "party", "couple"];
    private readonly HashSet<string> moods = ["flattering", "funny", "situations"];
    private bool BoldAllowed => BoldSettings.Contains(setting);
    private IEnumerable<string> Moods => BoldAllowed ? ["flattering", "funny", "situations", "bold"] : ["flattering", "funny", "situations"];

    private void PickSetting(string s)
    {
        setting = s;
        if (!BoldAllowed && moods.Remove("bold") && moods.Count == 0) moods.Add("flattering");
    }

    private static class CardLimits
    {
        public const int MaxTopics = 5;
        public const int PerWrite = 20;
    }

    /// <summary>The card list is always shown; generating and picking from decks open in a sheet over it.</summary>
    private void OpenSheet(string which)
    {
        open = null;
        aiNote = null;
        sheet = which;
        if (which == "decks") _ = LoadSourceDecks();
    }

    private void CloseSheet() => sheet = null;


    /// <summary>Topics grouped into pages; a topic outside these groups lands on the last page.</summary>
    private static readonly (string Group, string[] Codes)[] Groups =
    [
        ("everyday", ["everyday", "habits", "home", "food", "hobbies", "money", "work"]),
        ("personal", ["childhood", "memories", "firsts", "values", "fears", "regrets", "growth", "future"]),
        ("relationships", ["friendship", "family", "love", "long-distance", "dates", "needs", "conflict", "gratitude"]),
        ("fun", ["funny", "what-if", "travel", "adventure", "music", "stories", "dreams"]),
    ];

    private List<(string Group, List<TopicInfo> Members)> TopicPages
    {
        get
        {
            var pages = Groups.Select(g => (g.Group, Members: topics.Where(t => g.Codes.Contains(t.Code)).ToList())).ToList();
            var placed = Groups.SelectMany(g => g.Codes).ToHashSet();
            pages[^1].Members.AddRange(topics.Where(t => !placed.Contains(t.Code)));
            return [.. pages.Where(p => p.Members.Count > 0)];
        }
    }

    // "From decks": tick cards in other decks (or "Select all" to merge whole decks) and add them here.
    private ImmutableArray<Deck> sourceDecks = [];
    private readonly HashSet<string> openDecks = [];
    private readonly HashSet<string> picked = [];

    private static string Key(Deck deck, Card card) => $"{deck.Id}|{card.Id}";

    /// <summary>Already in this deck: the same card, or a card with the same text (a saved copy).</summary>
    private bool InDeck(Card card) =>
        cards.Any(c => c.Id == card.Id || (c.IsComplete && c.Preview(Text.UiLang) == PreviewOf(card)));

    private static string PreviewOf(Card card)
    {
        var text = card.TextFor(Text.UiLang);
        return text.Options.IsEmpty ? text.Text : string.Join(" / ", text.Options);
    }

    private async Task LoadSourceDecks()
    {
        if (!sourceDecks.IsEmpty) return;
        try { sourceDecks = [.. (await Content.GetDecksAsync()).Where(d => d.Id != Id)]; }
        catch (ContentUnavailableException) { sourceDecks = []; }
        StateHasChanged();
    }

    private void PickAll(Deck deck, IEnumerable<Card> addable, bool on)
    {
        foreach (var card in addable)
            if (on) picked.Add(Key(deck, card)); else picked.Remove(Key(deck, card));
    }

    private void AddPicked()
    {
        var added = 0;

        foreach (var deck in sourceDecks)
            foreach (var card in deck.Cards.Where(c => picked.Contains(Key(deck, c))))
            {
                if (InDeck(card)) continue; // the same card picked from two decks
                if (card.Kind.Style != Style) continue; // only cards for this deck's game
                cards.Add(EditCard.From(card));
                added++;
            }
        picked.Clear();
        addedNote = T.Plural("Editor_DecksAdded", added);
        sheet = null;
    }

    private bool CanWrite => Style == DeckStyle.Handoff ? moods.Count > 0 : pickedTopics.Count > 0 || !string.IsNullOrWhiteSpace(theme);

    private void ToggleTopic(string code)
    {
        if (!pickedTopics.Remove(code) && pickedTopics.Count < CardLimits.MaxTopics) pickedTopics.Add(code);
    }

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        if (Id is not null)
        {
            editKey = (await DeviceDecks.FindAsync(Id))?.EditKey;
            var deck = editKey is null ? null : await Content.GetDeckAsync(Id, fresh: true);
            notAllowed = deck is null;
            if (deck is not null)
            {
                name = deck.NameFor(Text.UiLang);
                cards = [.. deck.Cards.Select(EditCard.From)];
            }
        }
        // A new deck opens straight on "Generate", the quickest start; an existing one shows its cards.
        sheet = null;
        try { topics = await Content.GetTopicsAsync(); }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException) { topics = []; }
        loading = false;
    }

    private bool CanSave => name.Trim().Length > 0 && cards.Count > 0 && cards.All(c => c.IsComplete);

    private string Status =>
        error ?? note
        ?? (name.Trim().Length == 0 ? T["Editor_NeedName"]
            : cards.Count == 0 ? T["Editor_NeedCard"]
            : cards.Any(c => !c.IsComplete) ? T["Editor_Incomplete"]
            : "");

    private async Task WriteWithAi()
    {
        if (!CanWrite) return;
        writing = true;
        aiNote = null;
        try
        {
            var (written, problem) = await Content.WriteCardsAsync([.. pickedTopics], theme.Trim(), [.. depths], setting, [.. languages], CardLimits.PerWrite, Style, [.. moods]);
            if (problem is not null)
            {
                aiNote = problem == "429" ? T["Editor_TooMany"] : T["Editor_AiFailed"];
                return;
            }
            // Drop the empty card a new deck starts with, then add the written ones for review.
            cards.RemoveAll(c => !c.IsComplete);
            open = null;
            cards.AddRange(written.Select(EditCard.From));
            if (name.Trim().Length == 0)
            {
                var suggested = theme.Trim().Length > 0
                    ? theme.Trim()
                    : string.Join(", ", topics.Where(t => pickedTopics.Contains(t.Code)).Select(t => t.NameFor(Text.UiLang)));
                name = suggested.Length <= 60 ? suggested : suggested[..60];
            }
            addedNote = T.Plural("Editor_AiAdded", written.Length);
            sheet = null;
        }
        catch (HttpRequestException)
        {
            aiNote = T["Online_ConnectFailed"];
        }
        catch (Exception ex) when (ex is FormatException or System.Text.Json.JsonException)
        {
            aiNote = T["Editor_AiFailed"];
        }
        finally
        {
            writing = false;
        }
    }

    /// <summary>The game this deck is for: its cards' game, or the one picked while it is still empty.</summary>
    private DeckStyle Style => cards.Count == 0 ? chosenStyle : CardKinds.Get(cards[0].KindId).Style;

    /// <summary>The kinds a card may have: those of the deck's game.</summary>
    private IEnumerable<CardKind> KindsFor(EditCard card) => CardKinds.OfStyle(Style);

    private void AddCard()
    {
        var card = new EditCard
        {
            KindId = Style switch
            {
                DeckStyle.Blitz => CardKinds.Association.Id,
                DeckStyle.Handoff => CardKinds.Handoff.Id,
                _ => CardKinds.OpenQuestion.Id,
            },
        };
        cards.Add(card);
        open = card;
    }

    /// <summary>The last removed card and where it was, so a swipe by accident can be undone.</summary>
    private (EditCard Card, int Index)? removed;

    private void Remove(EditCard card)
    {
        var index = cards.IndexOf(card);
        if (index < 0) return;
        cards.RemoveAt(index);
        if (ReferenceEquals(open, card)) open = null;
        removed = card.IsComplete ? (card, index) : null; // an empty card is not worth an undo
    }

    private void Undo()
    {
        if (removed is not { } last) return;
        cards.Insert(Math.Min(last.Index, cards.Count), last.Card);
        removed = null;
    }

    private Deck Build() => new(
        Id ?? "new",
        ImmutableDictionary<Lang, string>.Empty.Add(Text.UiLang, name.Trim()),
        [.. cards.Select((c, i) => c.ToCard(i))]);

    private async Task Save()
    {
        if (!CanSave) return;
        busy = true;
        error = note = null;
        try
        {
            var result = Id is null
                ? await Content.CreateAsync(Build())
                : await Content.SaveAsync(Id, editKey!, Build());
            if (result.Error is { } problem)
            {
                error = problem switch
                {
                    "403" => T["Editor_NoKey"],
                    "429" => T["Editor_TooMany"],
                    _ => $"{T["Editor_SaveFailed"]} {problem}",
                };
                return;
            }
            if (Id is null)
            {
                Nav.NavigateTo($"decks/{result.Id}/edit", replace: true);
                return;
            }
            // Reload so new cards get their saved ids and later saves update them in place.
            if (await Content.GetDeckAsync(Id) is { } deck) cards = [.. deck.Cards.Select(EditCard.From)];
            open = null;
            note = T["Editor_Saved"];
        }
        catch (HttpRequestException)
        {
            error = T["Online_ConnectFailed"];
        }
        finally
        {
            busy = false;
        }
    }

}
