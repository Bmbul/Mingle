@page "/play"
@implements IDisposable
@inject Text T
@inject GameSession Session
@inject NavigationManager Nav

<PageTitle>Mingle</PageTitle>

@if (Session.State is { } state)
{
    var lang = Text.UiLang;
    var table = GameViews.ForTable(state, lang);

    if (state.Phase == GamePhase.Ended)
    {
        <main class="main">
            <h1 class="h1 big">@T["End_Title"]</h1>
            <p class="muted lead">@T.Plural("End_Played", state.History.Count)</p>
        </main>
        <footer class="foot">
            <a class="btn" href="setup">@T["End_NewGame"]</a>
            <a class="btn2" href="" @onclick="Session.Clear">@T["End_Home"]</a>
        </footer>
    }
    else
    {
        var round = state.Current!;
        var answeringId = ActiveAnswerer(state);

        <header class="top spread">
            <span class="muted">@T["Play_CardOf", table.CardNumber, table.CardCount]</span>
            <button class="text-btn" aria-expanded="@(confirmEnd ? "true" : "false")" @onclick="() => confirmEnd = !confirmEnd">@T["Play_End"]</button>
        </header>

        @if (confirmEnd)
        {
            <div class="confirm" role="alertdialog" aria-labelledby="confirm-end-title">
                <span id="confirm-end-title" class="h2">@T["Play_EndConfirm"]</span>
                <div class="row gap">
                    <button class="btn2 grow" @onclick="() => confirmEnd = false">@T["Play_KeepPlaying"]</button>
                    <button class="btn grow" @onclick="EndNow">@T["Play_End"]</button>
                </div>
            </div>
        }

        @if (state.Phase == GamePhase.Answering && answeringId is not null)
        {
            var player = state.Player(answeringId);
            var mine = GameViews.ForPlayer(state, answeringId);
            <main class="main">
                <p class="who">@T["Play_AnsweringAs", player.Name]</p>
                <CardFace View="mine" Lang="player.Lang" />
                <AnswerInput @key="@($"{round.Number}-{answeringId}")" View="mine" Players="state.Players" Lang="player.Lang"
                             OnAnswer="answer => Submit(answeringId, answer)" />
            </main>
        }
        else if (state.Phase == GamePhase.Answering)
        {
            var next = round.Answerers.First(id => !round.Answers.ContainsKey(id));
            <main class="main">
                <p class="who">@WhoLine.For(T, table, state.Settings.TurnStyle)</p>
                @* Swiping the card any way moves on to the next one. *@
                <SwipeCard OnSwipe="() => Do(new PassCard(Me(state)))" Next="@NextFace(table)" Last="@(table.Next is null)">
                    <CardFace View="table" ShowOptions="true" />
                </SwipeCard>
                <div class="card handoff">
                    <span class="h2">@T["Play_HandTo", state.Player(next).Name]</span>
                    <span class="muted small">@T["Play_HandToHint"]</span>
                    <button class="btn" @onclick="() => handoff = (round.Number, next)">@T["Play_AnswerNow"]</button>
                </div>
                <p class="muted center" role="status">@T["Play_Answered", table.AnsweredCount, table.AnswererIds.Length]</p>
            </main>
        }
        else
        {
            @* Swiping the card any way moves on to the next one. *@
            <main class="main">
                <p class="who">@WhoLine.For(T, table, state.Settings.TurnStyle)</p>
                <SwipeCard OnSwipe="() => Do(new NextCard(Me(state)))" Next="@NextFace(table)" Last="@(table.Next is null)">
                    <CardFace View="table" Compact="@(!table.RevealedAnswers.IsEmpty)" ShowOptions="@table.RevealedAnswers.IsEmpty" />
                    <RevealList View="table" />
                </SwipeCard>
            </main>
        }

        @if (error is not null)
        {
            <p class="error" role="alert">@T["Play_Error", error]</p>
        }
    }
}

@code {
    private (int Round, string PlayerId)? handoff;
    private string? error;
    private bool confirmEnd;

    private void EndNow()
    {
        confirmEnd = false;
        if (Session.State is { } state) Do(new EndGame(Me(state)));
    }

    protected override void OnInitialized()
    {
        if (Session.State is null) Nav.NavigateTo("setup", replace: true);
        Session.Changed += OnChanged;
    }

    // In pass-and-play the device acts for the group; reactions and button presses are recorded as the first player.
    private static string Me(GameState state) => state.Players[0].Id;

    /// <summary>The player whose private answer screen is open, if any.</summary>
    private string? ActiveAnswerer(GameState state)
    {
        var round = state.Current;
        if (round is null || state.Phase != GamePhase.Answering) return null;
        if (handoff is { } h && h.Round == round.Number && !round.Answers.ContainsKey(h.PlayerId)) return h.PlayerId;
        // With a single answerer there is nothing to hide from anyone, so skip the hand-off screen.
        return round.Answerers.Length == 1 ? round.Answerers[0] : null;
    }

    private void Submit(string playerId, Answer answer)
    {
        Do(new SubmitAnswer(playerId, answer));
        handoff = null;
    }

    private void Do(GameAction action)
    {
        try
        {
            error = null;
            Session.Dispatch(action);
        }
        catch (GameRuleException ex)
        {
            error = ex.Message;
        }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Session.Changed -= OnChanged;


    /// <summary>The next card, for under the top one.</summary>
    private static RenderFragment? NextFace(GameView view) =>
        view.Next is { } next ? @<UpcomingFace Card="next" /> : null;
}
