@page "/decks"
@inject Text T
@inject ContentService Content
@inject DeviceDeckStore DeviceDecks
@inject NavigationManager Nav

<PageTitle>@T["Decks_Title"] · Mingle</PageTitle>

<header class="top">
    <a class="icon" href="" aria-label="@T["Common_Back"]"><Icon Name="back" /></a>
    <h1 class="h1">@T["Decks_Title"]</h1>
</header>

<main class="main">
    <a class="btn" href="decks/new"><Icon Name="plus" Size="18" />@T["Decks_New"]</a>

    @if (loading)
    {
        <p class="muted center">@T["Online_Connecting"]</p>
    }
    else if (rows.Count == 0)
    {
        <p class="muted">@T["Decks_Empty"]</p>
    }
    else
    {
        <section class="stack">
            @foreach (var (entry, deck) in rows)
            {
                var e = entry;
                var name = deck?.NameFor(Text.UiLang) ?? T["Decks_Missing"];
                @* Tap opens the deck; swipe left uncovers Edit and Delete (js/swipe.js). *@
                <div class="swipe-row reveal" @key="e.Id">
                    <div class="swipe-actions">
                        @if (e.CanEdit)
                        {
                            <button class="swipe-action edit" @onclick="@(() => Nav.NavigateTo($"decks/{e.Id}/edit"))">
                                <Icon Name="pen" Size="18" /><span>@T["Decks_Edit"]</span>
                            </button>
                            <button class="swipe-action delete" @onclick="() => AskDelete(e, name)">
                                <Icon Name="close" Size="18" /><span>@T["Decks_Delete"]</span>
                            </button>
                        }
                        else
                        {
                            <button class="swipe-action delete" @onclick="() => RemoveFromList(e)">
                                <Icon Name="close" Size="18" /><span>@T["Decks_Remove"]</span>
                            </button>
                        }
                    </div>
                    <a class="check-row swipe-content" href="d/@e.Id" draggable="false">
                        @if (deck is not null)
                        {
                            <DeckBadge Style="deck.Style" />
                        }
                        <span class="grow">
                            <span class="row-title">@name</span>
                            <span class="muted small">
                                @(deck is null ? "" : T.Plural("Cards", deck.Cards.Length))@(e.CanEdit ? "" : $" · {T["Decks_ViewOnly"]}")
                            </span>
                        </span>
                    </a>
                </div>
            }
        </section>
        @if (removed is not null)
        {
            <div class="undo-bar" role="status">
                <span class="grow">@T["Decks_Removed"]</span>
                <button class="text-btn" @onclick="UndoRemove">@T["Editor_Undo"]</button>
            </div>
        }
        <p class="muted small">@T["Decks_DeviceNote"]</p>
    }
</main>

@if (toDelete is { } doomed)
{
    <div class="sheet-backdrop" @onclick="() => toDelete = null"></div>
    <div class="sheet" role="alertdialog" aria-modal="true" aria-labelledby="delete-title">
        <h2 id="delete-title" class="h2">@T["Decks_DeleteTitle", doomed.Name]</h2>
        <p class="muted">@T["Decks_DeleteWarning"]</p>
        @if (deleteError is not null)
        {
            <p class="error" role="alert">@deleteError</p>
        }
        <div class="row gap">
            <button class="btn2 grow" @onclick="() => toDelete = null">@T["End_Cancel"]</button>
            <button class="btn grow danger" disabled="@deleting" @onclick="Delete">@T["Decks_Delete"]</button>
        </div>
    </div>
}

@code {
    private bool loading = true;
    private List<(DeviceDeck Entry, Deck? Deck)> rows = [];

    // Deleting your own deck removes it for everyone, so it is confirmed first.
    private (DeviceDeck Entry, string Name)? toDelete;
    private bool deleting;
    private string? deleteError;

    // Removing a shared deck only takes it off this list, so it can be undone.
    private (DeviceDeck Entry, Deck? Deck, int Index)? removed;

    protected override async Task OnInitializedAsync()
    {
        foreach (var entry in await DeviceDecks.ListAsync())
            rows.Add((entry, await Content.GetDeckAsync(entry.Id, savedFirst: true)));
        loading = false;
    }

    private void AskDelete(DeviceDeck entry, string name)
    {
        deleteError = null;
        toDelete = (entry, name);
    }

    private async Task Delete()
    {
        if (toDelete is not { } doomed || doomed.Entry.EditKey is null) return;
        deleting = true;
        try
        {
            if (await Content.DeleteAsync(doomed.Entry.Id, doomed.Entry.EditKey))
            {
                rows.RemoveAll(r => r.Entry.Id == doomed.Entry.Id);
                toDelete = null;
            }
            else
            {
                deleteError = T["Editor_SaveFailed"];
            }
        }
        catch (HttpRequestException)
        {
            deleteError = T["Online_ConnectFailed"];
        }
        finally
        {
            deleting = false;
        }
    }

    private async Task RemoveFromList(DeviceDeck entry)
    {
        var index = rows.FindIndex(r => r.Entry.Id == entry.Id);
        if (index < 0) return;
        removed = (entry, rows[index].Deck, index);
        rows.RemoveAt(index);
        await DeviceDecks.RemoveAsync(entry.Id);
    }

    private async Task UndoRemove()
    {
        if (removed is not { } last) return;
        rows.Insert(Math.Min(last.Index, rows.Count), (last.Entry, last.Deck));
        await DeviceDecks.AddAsync(last.Entry.Id, last.Entry.EditKey);
        removed = null;
    }
}
