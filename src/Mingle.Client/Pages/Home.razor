@page "/"
@inject Text T
@inject GameSession Session

<PageTitle>Mingle</PageTitle>

<main class="main">
    <header class="home-top">
        <h1 class="brand">Mingle</h1>
        <LangPicker />
    </header>
    <p class="muted lead">@T["AppTagline"]</p>

    @if (Session.InProgress)
    {
        <a class="card banner" href="play">
            <span class="h2">@T["Home_Rejoin"]</span>
            <span class="accent-text">@T["Home_RejoinAction"]</span>
        </a>
    }

    <div class="stack">
        <a class="btn" href="setup">@T["Home_NewGame"]</a>
        <p class="muted center">@T["Home_PassAndPlay"]</p>
    </div>

    <section class="stack">
        <h2 class="label">@T["Home_PlayOnline"]</h2>
        <p class="muted">@T["Home_PlayOnlineDesc"]</p>
        <div class="row gap">
            <a class="btn2 grow" href="setup?online=true">@T["Home_CreateRoom"]</a>
            <a class="btn2 grow" href="join">@T["Home_JoinRoom"]</a>
        </div>
    </section>
</main>
