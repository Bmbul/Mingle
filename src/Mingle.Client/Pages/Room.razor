@page "/room/{Code}"
@implements IDisposable
@inject Text T
@inject RoomClient Rooms
@inject ContentService Content
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@Code · Mingle</PageTitle>

@if (Rooms.Reconnecting)
{
    <p class="banner-warn" role="status">@T["Online_Reconnecting"]</p>
}

@if (Rooms.View is not { } room)
{
    <main class="main"><p class="muted center">@T["Online_Connecting"]</p></main>
}
else if (room.Stage == RoomStage.Lobby)
{
    <header class="top spread">
        <span class="muted">@T["Online_Room"]</span>
        <button class="text-btn" @onclick="LeaveRoom">@T["Online_Leave"]</button>
    </header>
    <main class="main">
        <div class="card room-code-card">
            <p class="label">@T["Join_Code"]</p>
            <p class="room-code" aria-label="@string.Join(" ", room.Code.ToCharArray())">@room.Code</p>
            <button class="btn2" @onclick="Share">@T["Lobby_Share"]</button>
            @if (shareNote is not null)
            {
                <p class="muted small center" role="status">@shareNote</p>
            }
        </div>

        @if (room.Settings.Facts is { } factGame)
        {
            <p class="muted center"><Icon Name="idea" Size="16" /> @T[$"Facts_{factGame.Kind}"]</p>
        }
        @if (room.Settings.Guess is not null)
        {
            <p class="muted center"><Icon Name="target" Size="16" /> @T["Guess_Game"]</p>
        }
        <h2 class="label">@T["Setup_Players"] · @room.Players.Length</h2>
        @foreach (var player in room.Players)
        {
            <div class="player-line @(player.Connected ? "" : "away")">
                <span class="avatar" aria-hidden="true">@player.Name[..1].ToUpperInvariant()</span>
                <span class="grow">
                    <span class="row-title">@player.Name@(player.Id == room.YouId ? $" ({T["Online_You"]})" : "")</span>
                    <span class="muted small">
                        @string.Join(" · ", PlayerNotes(room, player))
                    </span>
                </span>
                <span class="lang-tag">@player.Lang.Code().ToUpperInvariant()</span>
            </div>
        }
        @if (room.Players.Length < MinPlayers(room))
        {
            <p class="muted">@T["Lobby_Waiting"]</p>
        }

        @if (room.Topics is { } topics)
        {
            <h2 class="label">@T["Lobby_YourTopics"]</h2>
            <p class="muted small">@T["Lobby_YourTopicsHint", topics.MaxPicks]</p>
            <div class="chips centered" role="group" aria-label="@T["Lobby_YourTopics"]">
                @foreach (var topic in topics.Offer)
                {
                    var on = topics.Picked.Contains(topic.Code);
                    var full = !on && topics.Picked.Length >= topics.MaxPicks;
                    <button class="chip @(on ? "on" : "")" aria-pressed="@(on ? "true" : "false")" disabled="@full"
                            @onclick="() => ToggleTopic(topics, topic.Code)">@topic.Name</button>
                }
            </div>
        }

        @if (EveryoneBrings(room))
        {
            <h2 class="label">@T["Lobby_YourDeck"]</h2>
            <p class="muted small">@T["Lobby_YourDeckHint"]</p>
            @* Only decks with cards everyone in the room can read. *@
            @foreach (var deck in decks.Where(d => d.Style == DeckStyle.Questions && (d.CountReadableBy(RoomLanguages(room)) > 0 || room.You?.DeckId == d.Id)))
            {
                var on = room.You?.DeckId == deck.Id;
                <button class="check-row @(on ? "on" : "")" aria-pressed="@(on ? "true" : "false")"
                        @onclick="() => Rooms.BringDeck(on ? null : deck.Id)">
                    <span class="box round @(on ? "on" : "")" aria-hidden="true">@if (on) { <Icon Name="check" Size="14" Stroke="3" /> }</span>
                    <span class="grow">
                        <span class="row-title">@deck.NameFor(Text.UiLang)</span>
                        <span class="muted small">@T.Plural("Cards", deck.CountReadableBy(RoomLanguages(room)))</span>
                    </span>
                </button>
            }
        }
    </main>
    <footer class="foot">
        @if (room.YouAreHost)
        {
            var noDecks = EveryoneBrings(room) && room.Players.All(p => p.DeckId is null);
            var noTopics = room.Settings.Source == DeckSource.Topics && room.Players.All(p => !p.PickedTopics);
            var tooFew = room.Players.Length < MinPlayers(room);
            <p class="muted center" role="status">@(tooFew ? (MinPlayers(room) > 2 ? T["Lobby_NeedThree"] : T["Lobby_NeedTwo"]) : noDecks ? T["Lobby_PickDecks"] : noTopics ? T["Lobby_PickTopics"] : T["Lobby_EveryoneIn"])</p>
            <button class="btn" disabled="@(tooFew || noDecks || noTopics)" @onclick="Rooms.StartGame">@T["Setup_Start"]</button>
        }
        else
        {
            <p class="muted center" role="status">@T["Lobby_WaitingHost"]</p>
        }
    </footer>
}
else if (room.Stage == RoomStage.Writing)
{
    <main class="main center-screen" role="status">
        <div class="spinner" aria-hidden="true"></div>
        <p class="h2 center">@T["Writing_Title"]</p>
        <p class="muted center">@T["Writing_Hint"]</p>
    </main>
}
else if (room.Guess is { } guessView)
{
    <GuessRoom Room="room" Guess="guessView" OnHome="LeaveRoom" />
}
else if (room.Facts is { } facts)
{
    <FactsRoom Room="room" Facts="facts" OnHome="LeaveRoom" />
}
else if (room.Stage == RoomStage.Playing && room.Game is { } game)
{
    var myLang = room.You?.Lang ?? Text.UiLang;
    <header class="top spread">
        <span class="muted">@T["Play_CardOf", game.CardNumber, game.CardCount]</span>
        <button class="text-btn" aria-expanded="@(confirmEnd ? "true" : "false")" @onclick="() => confirmEnd = !confirmEnd">@T["Play_End"]</button>
    </header>
    @if (confirmEnd)
    {
        <div class="confirm" role="alertdialog" aria-labelledby="confirm-end-title">
            <span id="confirm-end-title" class="h2">@T["Play_EndConfirm"]</span>
            <div class="row gap">
                <button class="btn2 grow" @onclick="() => confirmEnd = false">@T["Play_KeepPlaying"]</button>
                <button class="btn grow" @onclick="EndNow">@T["Play_End"]</button>
            </div>
        </div>
    }

    <main class="main">
        @if (room.LibraryCards && game.CardNumber == 1)
        {
            <p class="muted small">@T["Writing_Library"]</p>
        }
        <p class="who">@WhoLine.For(T, game, room.Settings.Game.TurnStyle)</p>
        @if (game.Phase == GamePhase.Answering)
        {
            <CardFace View="game" Lang="myLang" ShowOptions="@(!game.MustAnswer)" />
            @if (game.MustAnswer && game.MyAnswer is null)
            {
                <AnswerInput @key="@game.CardNumber" View="game" Players="Players(room)" Lang="myLang" OnAnswer="Rooms.SubmitAnswer" />
            }
            else
            {
                <div class="card waiting" role="status">
                    <span class="h2">@T["Online_WaitingOthers"]</span>
                    <span class="muted">@T["Play_Answered", game.AnsweredCount, game.AnswererIds.Length]</span>
                </div>
            }
        }
        else
        {
            <CardFace View="game" Lang="myLang" Compact="@(!game.RevealedAnswers.IsEmpty)" ShowOptions="@game.RevealedAnswers.IsEmpty" />
            <RevealList View="game" />
            <div class="talk">
                <p class="h2">@T["Play_TalkAboutIt"]</p>
                <p class="muted small">@T["Play_TakeYourTime"]</p>
            </div>
        }
    </main>

    <footer class="foot row">
        @if (game.Phase == GamePhase.Answering)
        {
            <button class="btn2 grow" @onclick="Rooms.Pass">@T["Play_Pass"]</button>
        }
        else
        {
            <button class="react @(game.MyReaction == true ? "on" : "")" aria-label="@T["Play_Like"]" aria-pressed="@(game.MyReaction == true ? "true" : "false")"
                    @onclick="() => Rooms.React(game.MyReaction == true ? null : true)"><Icon Name="like" Size="22" /></button>
            <button class="react @(game.MyReaction == false ? "on" : "")" aria-label="@T["Play_Dislike"]" aria-pressed="@(game.MyReaction == false ? "true" : "false")"
                    @onclick="() => Rooms.React(game.MyReaction == false ? null : false)"><Icon Name="dislike" Size="22" /></button>
            <button class="btn grow" @onclick="Rooms.Next">@T["Play_Next"]</button>
        }
    </footer>
}
else if (room.Summary is { } summary)
{
    <main class="main">
        <h1 class="h1 big">@T["End_Title"]</h1>
        <p class="muted lead">
            @T.Plural("End_Played", summary.Played)
            @if (summary.Passed > 0)
            {
                <span> · @T["End_Passed", summary.Passed]</span>
            }
        </p>
        <h2 class="label">@T["End_Liked"]</h2>
        @if (summary.Liked.IsEmpty)
        {
            <p class="muted">@T["End_NoLikes"]</p>
        }
        @foreach (var card in summary.Liked)
        {
            <div class="card">
                <span class="row-title">@card.Text</span>
                <span class="muted small">@T.KindName(card.KindId) · @T[$"Depth_{card.Depth}"]</span>
            </div>
        }
    </main>
    <footer class="foot">
        @if (summary.Cards is not null)
        {
            <button class="btn2" @onclick="() => OpenSave(summary)"><Icon Name="save" Size="18" />@T["End_SaveDeck"]</button>
        }
        <button class="btn" @onclick="LeaveRoom">@T["End_Home"]</button>
    </footer>

    @if (saveDeck is { } toSave)
    {
        <div class="sheet-backdrop" @onclick="() => saveDeck = null"></div>
        <div class="sheet" role="dialog" aria-modal="true" aria-labelledby="save-title">
            <h2 id="save-title" class="h2">@T["End_SaveDeck"]</h2>
            @if (savedId is not null)
            {
                <p role="status">@T["End_Saved"]</p>
                <div class="row gap">
                    <button class="btn2 grow" @onclick="() => saveDeck = null">@T["End_Close"]</button>
                    <a class="btn grow" href="decks/@savedId/edit">@T["End_OpenDeck"]</a>
                </div>
            }
            else
            {
                var likedCount = toSave.Cards.Count(c => likedIds.Contains(c.Id));
                <div class="stack" role="radiogroup">
                    <OptionCard Selected="@(!likedOnly)" OnSelect="() => likedOnly = false" Title="@T["End_SaveAll", toSave.Cards.Length]" />
                    @if (likedCount > 0)
                    {
                        <OptionCard Selected="@likedOnly" OnSelect="() => likedOnly = true" Title="@T["End_SaveLiked", likedCount]" />
                    }
                </div>
                <label class="label" for="save-name">@T["Editor_Name"]</label>
                <input id="save-name" class="field" maxlength="60" @bind="saveName" @bind:event="oninput" />
                @if (saveError is not null)
                {
                    <p class="error" role="alert">@saveError</p>
                }
                <div class="row gap">
                    <button class="btn2 grow" @onclick="() => saveDeck = null">@T["End_Cancel"]</button>
                    <button class="btn grow" disabled="@(saving || saveName.Trim().Length == 0)" @onclick="SaveDeck">@T["Editor_Save"]</button>
                </div>
            }
        </div>
    }
}

@if (Rooms.Error is { } error)
{
    <p class="error" role="alert">@error</p>
}

@code {
    [Parameter] public string Code { get; set; } = "";

    private bool confirmEnd;
    private ImmutableArray<Deck> decks = [];
    private string? shareNote;

    protected override async Task OnInitializedAsync()
    {
        Rooms.Changed += OnChanged;
        Code = Code.ToUpperInvariant();

        bool seated;
        try { seated = await Rooms.RejoinSaved(Code); }
        catch (Exception) { seated = false; }

        if (!seated) Nav.NavigateTo($"join/{Code}", replace: true);

        try { decks = await Content.GetDecksAsync(); }
        catch (ContentUnavailableException) { decks = []; }
    }

    private Task ToggleTopic(TopicChoice topics, string code) =>
        Rooms.PickTopics(topics.Picked.Contains(code) ? topics.Picked.Remove(code) : topics.Picked.Add(code));

    private static int MinPlayers(RoomView room) =>
        room.Settings.Facts is { } facts ? FactGame.MinPlayers(facts.Kind) : Game.MinPlayers;

    private static Lang[] RoomLanguages(RoomView room) => [.. room.Players.Select(p => p.Lang).Distinct()];

    private static bool EveryoneBrings(RoomView room) => room.Settings.Source == DeckSource.Everyone;

    private IEnumerable<string> PlayerNotes(RoomView room, RoomPlayer player)
    {
        if (player.IsHost) yield return T["Lobby_Host"];
        if (!player.Connected) yield return T["Lobby_Offline"];
        if (room.Settings.Source == DeckSource.Topics)
            yield return player.PickedTopics ? T["Lobby_TopicsPicked"] : T["Lobby_TopicsPicking"];
        if (EveryoneBrings(room))
            yield return player.DeckId is null ? T["Lobby_NoDeck"] : decks.FirstOrDefault(d => d.Id == player.DeckId)?.NameFor(Text.UiLang) ?? T["Lobby_OwnDeck"];
    }

    private static ImmutableArray<Player> Players(RoomView room) =>
        [.. room.Players.Select(p => new Player(p.Id, p.Name, p.Lang))];

    private async Task Share()
    {
        var url = Nav.ToAbsoluteUri($"join/{Code}").ToString();
        var result = await JS.InvokeAsync<string>("mingle.share", url, "Mingle");
        shareNote = result switch
        {
            "copied" => T["Lobby_Copied"],
            "failed" => url,
            _ => null,
        };
    }

    private async Task EndNow()
    {
        confirmEnd = false;
        await Rooms.EndGame();
    }

    // "Save as deck" after an "Our topics" game: each player saves their own copy.
    private Deck? saveDeck;
    private HashSet<string> likedIds = [];
    private bool likedOnly;
    private string saveName = "";
    private bool saving;
    private string? saveError;
    private string? savedId;

    private void OpenSave(GameSummary summary)
    {
        if (summary.Cards is null) return;
        saveDeck = DeckJson.Parse(summary.Cards);
        likedIds = summary.LikedIds.IsDefault ? [] : [.. summary.LikedIds];
        likedOnly = false;
        saveName = saveDeck.NameFor(Text.UiLang);
        if (saveName.Length > 60) saveName = saveName[..60];
        saveError = null;
        savedId = null;
    }

    private async Task SaveDeck()
    {
        if (saveDeck is null) return;
        saving = true;
        saveError = null;
        try
        {
            var cards = likedOnly ? saveDeck.Cards.Where(c => likedIds.Contains(c.Id)).ToImmutableArray() : saveDeck.Cards;
            var deck = new Deck("new", ImmutableDictionary<Lang, string>.Empty.Add(Text.UiLang, saveName.Trim()), cards);
            var result = await Content.CreateAsync(deck);
            if (result.Error is null) savedId = result.Id;
            else saveError = T["Editor_SaveFailed"];
        }
        catch (HttpRequestException)
        {
            saveError = T["Online_ConnectFailed"];
        }
        finally
        {
            saving = false;
        }
    }

    private async Task LeaveRoom()
    {
        await Rooms.Leave();
        Nav.NavigateTo("");
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Rooms.Changed -= OnChanged;
}
