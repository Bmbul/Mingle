@page "/setup"
@inject Text T
@inject GameSession Session
@inject ContentService Content
@inject NavigationManager Nav

<PageTitle>@T["Setup_Title"] · Mingle</PageTitle>

<header class="top">
    <a class="icon" href="" aria-label="@T["Common_Back"]"><Icon Name="back" /></a>
    <h1 class="h1">@T["Setup_Title"]</h1>
</header>

<main class="main">
    <section class="stack">
        <h2 class="label">@T["Setup_Players"]</h2>
        @foreach (var row in players)
        {
            <div class="player-row">
                <label class="visually-hidden" for="name-@row.Id">@T["Setup_PlayerName"]</label>
                <input id="name-@row.Id" class="field" placeholder="@T["Setup_PlayerName"]" maxlength="24"
                       autocomplete="off" @bind="row.Name" @bind:event="oninput" />
                <label class="visually-hidden" for="lang-@row.Id">@T["Setup_PlayerLang"]</label>
                <select id="lang-@row.Id" class="field lang-select" @bind="row.Lang">
                    @foreach (var lang in Langs.All)
                    {
                        <option value="@lang" lang="@lang.Code()">@lang.Code().ToUpperInvariant()</option>
                    }
                </select>
                @if (players.Count > Game.MinPlayers)
                {
                    <button class="icon" aria-label="@T["Setup_RemovePlayer"]" @onclick="() => players.Remove(row)"><Icon Name="close" /></button>
                }
            </div>
        }
        @if (players.Count < MaxPlayers)
        {
            <button class="ghost" @onclick="AddPlayer"><Icon Name="plus" Size="18" />@T["Setup_AddPlayer"]</button>
        }
    </section>

    <section class="stack">
        <h2 class="label">@T["Setup_OnePhone"]</h2>
        <div class="two" role="group" aria-label="@T["Setup_OnePhone"]">
            <OptionCard Selected="@(!passThePhone)" OnSelect="() => passThePhone = false"
                        Title="@T["Setup_OutLoud"]" Description="@T["Setup_OutLoudDesc"]" />
            <OptionCard Selected="@passThePhone" OnSelect="() => passThePhone = true"
                        Title="@T["Setup_PassPhone"]" Description="@T["Setup_PassPhoneDesc"]" />
        </div>
    </section>

    @if (passThePhone)
    {
        <section class="stack">
            <h2 class="label">@T["Setup_Answers"]</h2>
            <div class="two" role="group" aria-label="@T["Setup_Answers"]">
                <OptionCard Selected="@(mode == AnswerMode.Written)" OnSelect="() => mode = AnswerMode.Written"
                            Title="@T["Setup_Write"]" Description="@T["Setup_WriteDesc"]" />
                <OptionCard Selected="@(mode == AnswerMode.Talk)" OnSelect="() => mode = AnswerMode.Talk"
                            Title="@T["Setup_Talk"]" Description="@T["Setup_TalkDesc"]" />
            </div>
        </section>
    }

    <section class="stack">
        <h2 class="label">@T["Setup_Decks"]</h2>
        @foreach (var deck in decks)
        {
            var on = deckIds.Contains(deck.Id);
            <button class="check-row @(on ? "on" : "")" aria-pressed="@(on ? "true" : "false")" @onclick="() => Toggle(deckIds, deck.Id)">
                <span class="box @(on ? "on" : "")" aria-hidden="true">@if (on) { <Icon Name="check" Size="14" Stroke="3" /> }</span>
                <span class="grow">
                    <span class="row-title">@deck.NameFor(Text.UiLang)</span>
                    <span class="muted small">@T.Plural("Cards", deck.Cards.Length)</span>
                </span>
            </button>
        }
    </section>

    <section class="stack">
        <h2 class="label">@T["Setup_GameTypes"]</h2>
        <div class="grid2">
            @foreach (var kind in CardKinds.All)
            {
                var on = kindIds.Contains(kind.Id);
                <button class="tile @(on ? "on" : "")" aria-pressed="@(on ? "true" : "false")" @onclick="() => Toggle(kindIds, kind.Id)">
                    <span class="row-title">@T.KindName(kind.Id)</span>
                    <span class="muted small">@T[$"KindEx_{kind.Id}"]</span>
                </button>
            }
        </div>
    </section>

    <section class="stack">
        <h2 class="label">@T["Setup_Depth"]</h2>
        <div class="chips">
            @for (var depth = 1; depth <= 3; depth++)
            {
                var d = depth;
                var on = d >= minDepth && d <= maxDepth;
                <button class="chip @(on ? "on" : "")" aria-pressed="@(on ? "true" : "false")" @onclick="() => ToggleDepth(d)">@T[$"Depth_{d}"]</button>
            }
        </div>
    </section>

    <section class="stack">
        <h2 class="label">@T["Setup_WhoAnswers"]</h2>
        <div class="chips">
            <button class="chip @(turnStyle == TurnStyle.Everyone ? "on" : "")" aria-pressed="@(turnStyle == TurnStyle.Everyone ? "true" : "false")"
                    @onclick="() => turnStyle = TurnStyle.Everyone">@T["Setup_Everyone"]</button>
            <button class="chip @(turnStyle == TurnStyle.TakeTurns ? "on" : "")" aria-pressed="@(turnStyle == TurnStyle.TakeTurns ? "true" : "false")"
                    @onclick="() => turnStyle = TurnStyle.TakeTurns">@T["Setup_TakeTurns"]</button>
        </div>
    </section>

    <section class="stack">
        <h2 class="label">@T["Setup_CardCount"]</h2>
        <div class="chips">
            @foreach (var count in new[] { 10, 20, 30 })
            {
                var c = count;
                <button class="chip @(cardCount == c ? "on" : "")" aria-pressed="@(cardCount == c ? "true" : "false")" @onclick="() => cardCount = c">@c</button>
            }
        </div>
    </section>
</main>

<footer class="foot">
    <p class="muted center" role="status">@Summary</p>
    <button class="btn" disabled="@(!CanStart)" @onclick="Start">@T["Setup_Start"]</button>
</footer>

@code {
    private const int MaxPlayers = 8;

    private sealed class PlayerRow
    {
        public string Id { get; } = Guid.NewGuid().ToString("N")[..8];
        public string Name { get; set; } = "";
        public Lang Lang { get; set; } = Text.UiLang;
    }

    private List<PlayerRow> players = [];
    private ImmutableArray<Deck> decks = [];
    private HashSet<string> deckIds = [];
    private HashSet<string> kindIds = CardKinds.All.Select(k => k.Id).ToHashSet();
    private AnswerMode mode = AnswerMode.Written;
    private TurnStyle turnStyle = TurnStyle.Everyone;
    private bool passThePhone;
    private bool loadFailed;
    private int minDepth = 1, maxDepth = 3, cardCount = 20;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            decks = await Content.GetDecksAsync();
        }
        catch (ContentUnavailableException)
        {
            loadFailed = true;
        }
        deckIds = decks.Select(d => d.Id).ToHashSet();

        if (Session.LastSetup is { } last)
        {
            players = last.Players.Select(p => new PlayerRow { Name = p.Name, Lang = p.Lang }).ToList();
            deckIds = last.DeckIds.Where(id => decks.Any(d => d.Id == id)).ToHashSet();
            kindIds = last.Settings.KindIds.ToHashSet();
            mode = last.Settings.AnswerMode == AnswerMode.OutLoud ? AnswerMode.Written : last.Settings.AnswerMode;
            turnStyle = last.Settings.TurnStyle;
            passThePhone = last.PassThePhone;
            (minDepth, maxDepth, cardCount) = (last.Settings.MinDepth, last.Settings.MaxDepth, last.Settings.CardCount);
        }
        else
        {
            players = [new PlayerRow(), new PlayerRow()];
        }
    }

    private ImmutableArray<Player> NamedPlayers =>
        players.Where(p => !string.IsNullOrWhiteSpace(p.Name))
               .Select(p => new Player(p.Id, p.Name.Trim(), p.Lang))
               .ToImmutableArray();

    private GameSettings Settings => new()
    {
        KindIds = kindIds.ToImmutableHashSet(),
        MinDepth = minDepth,
        MaxDepth = maxDepth,
        AnswerMode = passThePhone ? mode : AnswerMode.OutLoud,
        TurnStyle = turnStyle,
        CardCount = cardCount,
    };

    private int MatchingCards =>
        Game.BuildPool(decks.Where(d => deckIds.Contains(d.Id)), Settings, NamedPlayers.IsEmpty ? [new Player("x", "x", Text.UiLang)] : NamedPlayers).Length;

    private bool CanStart => NamedPlayers.Length >= Game.MinPlayers && MatchingCards > 0;

    private string Summary =>
        loadFailed ? T["Setup_LoadFailed"]
        : NamedPlayers.Length < Game.MinPlayers ? T["Setup_NeedPlayers"]
        : MatchingCards == 0 ? T["Setup_NoCards"]
        : T.Plural("Setup_Matches", MatchingCards);

    private void AddPlayer() => players.Add(new PlayerRow());

    private static void Toggle(HashSet<string> set, string id)
    {
        if (!set.Remove(id)) set.Add(id);
    }

    // Depth is a range: tapping outside it extends it, tapping an end shrinks it, tapping the middle selects only that depth.
    private void ToggleDepth(int depth)
    {
        if (depth < minDepth) minDepth = depth;
        else if (depth > maxDepth) maxDepth = depth;
        else if (minDepth == maxDepth) return;
        else if (depth == minDepth) minDepth++;
        else if (depth == maxDepth) maxDepth--;
        else minDepth = maxDepth = depth;
    }

    private void Start()
    {
        if (!CanStart) return;
        Session.Start(new SetupChoices(NamedPlayers, Settings, deckIds.ToImmutableHashSet(), passThePhone), decks);
        Nav.NavigateTo("play");
    }
}
