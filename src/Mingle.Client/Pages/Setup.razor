@page "/setup"
@inject Text T
@inject GameSession Session
@inject BlitzSession Blitzes
@inject HandoffSession HandoffGames
@inject StorySession StorySessions
@inject FactSession FactGames
@inject ContentService Content
@inject NavigationManager Nav
@inject RoomClient Rooms
@inject IJSRuntime JS

<PageTitle>@Title · Mingle</PageTitle>

<header class="top">
    <a class="icon" href="" aria-label="@T["Common_Back"]"><Icon Name="back" /></a>
    <h1 class="h1">@Title</h1>
</header>

<main class="main">
    <section class="stack">
        <h2 class="label">@(Online ? T["Setup_YourName"] : T["Setup_Players"])</h2>
        @foreach (var row in Online ? players.Take(1) : players)
        {
            <div class="player-row">
                <label class="visually-hidden" for="name-@row.Id">@T["Setup_PlayerName"]</label>
                @* On one phone an empty name is fine: the placeholder ("Player 2") is used instead. *@
                <input id="name-@row.Id" class="field" placeholder="@(Online ? T["Setup_PlayerName"] : DefaultName(row))" maxlength="24"
                       autocomplete="off" @bind="row.Name" @bind:event="oninput" />
                @if (!Online)
                {
                    <label class="visually-hidden" for="lang-@row.Id">@T["Setup_PlayerLang"]</label>
                    <select id="lang-@row.Id" class="field lang-select" @bind="row.Lang">
                        @foreach (var lang in Langs.All)
                        {
                            <option value="@lang" lang="@lang.Code()">@lang.Code().ToUpperInvariant()</option>
                        }
                    </select>
                }
                @if (!Online && players.Count > Game.MinPlayers)
                {
                    <button class="icon" aria-label="@T["Setup_RemovePlayer"]" @onclick="() => players.Remove(row)"><Icon Name="close" /></button>
                }
            </div>
        }
        @if (!Online && players.Count < MaxPlayers)
        {
            <button class="ghost" @onclick="AddPlayer"><Icon Name="plus" Size="18" />@T["Setup_AddPlayer"]</button>
        }
    </section>

    @* Choose the game first; each game then shows its own options below. Online has the games played on everyone's phone. *@
    <section class="stack">
        <h2 class="label">@T["Setup_Game"]</h2>
        <div class="seg grid2" role="group" aria-label="@T["Setup_Game"]">
            @foreach (var (id, icon, label) in GameChoices)
            {
                var on = id == GameId;
                <button class="@(on ? "on" : "")" aria-pressed="@(on ? "true" : "false")" @onclick="@(() => PickMode(id))">
                    <Icon Name="@icon" Size="20" /><span>@T[label]</span>
                </button>
            }
        </div>
        @* Phones have no hover, so one short phrase says what the current choice means. *@
        @if (!Online || !Questions)
        {
            <p class="muted small">@HowToPlayLine</p>
        }
    </section>

    @if (oneTruth)
    {
        <section class="stack">
            <h2 class="label">@T["Facts_Find"]</h2>
            <div class="chips" role="group" aria-label="@T["Facts_Find"]">
                <button class="chip @(!findTheLie ? "on" : "")" aria-pressed="@(!findTheLie ? "true" : "false")" @onclick="() => findTheLie = false">@T["Facts_FindTruth"]</button>
                <button class="chip @(findTheLie ? "on" : "")" aria-pressed="@(findTheLie ? "true" : "false")" @onclick="() => findTheLie = true">@T["Facts_FindLie"]</button>
            </div>
            <p class="muted small">@T[findTheLie ? "Facts_FindLieHint" : "Facts_FindTruthHint"]</p>
        </section>
    }

    @if (whoseFact || trueOrFalse)
    {
        <section class="stack">
            <h2 class="label">@T["Facts_Each"]</h2>
            <div class="chips" role="group" aria-label="@T["Facts_Each"]">
                @for (var n = 1; n <= FactGame.MaxFactsEach; n++)
                {
                    var count = n;
                    <button class="chip @(factsEach == count ? "on" : "")" aria-pressed="@(factsEach == count ? "true" : "false")" @onclick="() => factsEach = count">@count</button>
                }
            </div>
        </section>
    }
    @if (whoseFact)
    {
        <section class="stack">
            <h2 class="label">@T["Facts_ShowAuthor"]</h2>
            <div class="chips" role="group" aria-label="@T["Facts_ShowAuthor"]">
                <button class="chip @(revealEach ? "on" : "")" aria-pressed="@(revealEach ? "true" : "false")" @onclick="() => revealEach = true">@T["Facts_AfterEach"]</button>
                <button class="chip @(!revealEach ? "on" : "")" aria-pressed="@(!revealEach ? "true" : "false")" @onclick="() => revealEach = false">@T["Facts_AtTheEnd"]</button>
            </div>
            <p class="muted small">@T[revealEach ? (Online ? "Facts_AfterEachHint" : "Facts_AfterEachLocalHint") : "Facts_AtTheEndHint"]</p>
        </section>
    }

    @* Questions: out loud, or answers collected secretly (one phone passed around, or everyone's own phone online). *@
    @if (Questions)
    {
    <section class="stack">
        <h2 class="label">@T["Setup_HowToAnswer"]</h2>
        <div class="seg-row">
            @if (!Online)
            {
                <div class="seg" role="group" aria-label="@T["Setup_HowToAnswer"]">
                    <button class="@(!passThePhone ? "on" : "")" aria-pressed="@(!passThePhone ? "true" : "false")"
                            title="@T["Setup_OutLoudDesc"]" @onclick="() => passThePhone = false">
                        <Icon Name="speaker" Size="20" /><span>@T["Setup_OutLoud"]</span>
                    </button>
                    <button class="@(passThePhone ? "on" : "")" aria-pressed="@(passThePhone ? "true" : "false")"
                            title="@T["Setup_PassPhoneDesc"]" @onclick="() => passThePhone = true">
                        <Icon Name="pass" Size="20" /><span>@T["Setup_SecretAnswers"]</span>
                    </button>
                </div>
            }
            @if (Online || passThePhone)
            {
                <div class="seg" role="group" aria-label="@T["Setup_Answers"]">
                    <button class="@(mode == AnswerMode.Written ? "on" : "")" aria-pressed="@(mode == AnswerMode.Written ? "true" : "false")"
                            title="@T["Setup_WriteDesc"]" @onclick="() => mode = AnswerMode.Written">
                        <Icon Name="pen" Size="20" /><span>@T["Setup_WriteShort"]</span>
                    </button>
                    <button class="@(mode == AnswerMode.Talk ? "on" : "")" aria-pressed="@(mode == AnswerMode.Talk ? "true" : "false")"
                            title="@T["Setup_TalkDesc"]" @onclick="() => mode = AnswerMode.Talk">
                        <Icon Name="chat" Size="20" /><span>@T["Setup_TalkShort"]</span>
                    </button>
                </div>
                @* Who answers only matters when the app collects answers; out loud, the card just names whose turn it is. *@
                <div class="seg" role="group" aria-label="@T["Setup_WhoAnswers"]">
                    <button class="@(turnStyle == TurnStyle.Everyone ? "on" : "")" aria-pressed="@(turnStyle == TurnStyle.Everyone ? "true" : "false")"
                            @onclick="() => turnStyle = TurnStyle.Everyone">
                        <Icon Name="people" Size="20" /><span>@T["Setup_EveryoneShort"]</span>
                    </button>
                    <button class="@(turnStyle == TurnStyle.TakeTurns ? "on" : "")" aria-pressed="@(turnStyle == TurnStyle.TakeTurns ? "true" : "false")"
                            @onclick="() => turnStyle = TurnStyle.TakeTurns">
                        <Icon Name="refresh" Size="20" /><span>@T["Setup_TakeTurnsShort"]</span>
                    </button>
                </div>
            }
        </div>
        @if (Online)
        {
            <p class="muted small">@HowToPlayLine</p>
        }
    </section>
    }

    @if (Online && Questions)
    {
        <section class="stack">
            <h2 class="label">@T["Setup_Source"]</h2>
            <div class="stack" role="group" aria-label="@T["Setup_Source"]">
                <OptionCard Selected="@(source == DeckSource.Topics)" OnSelect="() => source = DeckSource.Topics"
                            Title="@T["Setup_SourceTopics"]" Description="@T["Setup_SourceTopicsDesc"]" />
                <OptionCard Selected="@(source == DeckSource.Everyone)" OnSelect="() => source = DeckSource.Everyone"
                            Title="@T["Setup_SourceEveryone"]" Description="@T["Setup_SourceEveryoneDesc"]" />
                <OptionCard Selected="@(source == DeckSource.Chosen)" OnSelect="() => source = DeckSource.Chosen"
                            Title="@T["Setup_SourceChosen"]" Description="@T["Setup_SourceChosenDesc"]" />
            </div>
        </section>

        @if (source == DeckSource.Topics)
        {
            <section class="stack">
                <h2 class="label">@T["Editor_AiDepth"]</h2>
                <div class="chips" role="group" aria-label="@T["Editor_AiDepth"]">
                    @for (var level = 1; level <= 3; level++)
                    {
                        var d = level;
                        var on = depths.Contains(d);
                        @* At least one depth stays on; all three is the usual light-to-deep mix. *@
                        <button class="chip @(on ? "on" : "")" aria-pressed="@(on ? "true" : "false")" disabled="@(on && depths.Count == 1)"
                                @onclick="() => { if (!depths.Remove(d)) depths.Add(d); }">@T[$"Depth_{d}"]</button>
                    }
                </div>
            </section>
        }
    }

    @if (stories)
    {
        <section class="stack">
            <h2 class="label">@T["Story_Style"]</h2>
            <div class="seg" role="group" aria-label="@T["Story_Style"]">
                <button class="@(storyBlind ? "on" : "")" aria-pressed="@(storyBlind ? "true" : "false")" @onclick="() => storyBlind = true">
                    <span>🙈</span><span>@T["Story_Blind"]</span>
                </button>
                <button class="@(!storyBlind ? "on" : "")" aria-pressed="@(!storyBlind ? "true" : "false")" @onclick="() => storyBlind = false">
                    <span>📖</span><span>@T["Story_Live"]</span>
                </button>
            </div>
            <p class="muted small">@(storyBlind ? T["Story_BlindLine"] : T["Story_LiveLine"])</p>
        </section>

        <section class="stack">
            <h2 class="label">@T["Story_Theme"]</h2>
            <div class="chips">
                @foreach (var option in StoryThemes)
                {
                    var t = option;
                    <button class="chip @(storyTheme == t ? "on" : "")" aria-pressed="@(storyTheme == t ? "true" : "false")"
                            @onclick="() => storyTheme = t">@T[$"StoryTheme_{t}"]</button>
                }
            </div>
        </section>

        <section class="stack">
            <h2 class="label">@T["Story_Length"]</h2>
            <div class="chips">
                <button class="chip @(!storyLong ? "on" : "")" aria-pressed="@(!storyLong ? "true" : "false")" @onclick="() => storyLong = false">@T["Story_Short"]</button>
                <button class="chip @(storyLong ? "on" : "")" aria-pressed="@(storyLong ? "true" : "false")" @onclick="() => storyLong = true">@T["Story_Long"]</button>
            </div>
        </section>
    }

    @if (handoff)
    {
        <section class="stack">
            <h2 class="label">@T["Setup_HandoffHow"]</h2>
            <div class="chips">
                <button class="chip @(handoffSecret ? "on" : "")" aria-pressed="@(handoffSecret ? "true" : "false")" @onclick="() => handoffSecret = true">@T["Setup_HandoffSecret"]</button>
                <button class="chip @(!handoffSecret ? "on" : "")" aria-pressed="@(!handoffSecret ? "true" : "false")" @onclick="() => handoffSecret = false">@T["Setup_HandoffAloud"]</button>
            </div>
            <p class="muted small">@T[handoffSecret ? "Setup_HandoffSecretHint" : "Setup_HandoffAloudHint"]</p>
        </section>
        @if (handoffSecret)
        {
        <section class="stack">
            <h2 class="label">@T["Setup_HandoffExtras"]</h2>
            <div class="chips">
                <button class="chip @(handoffGuess ? "on" : "")" aria-pressed="@(handoffGuess ? "true" : "false")" @onclick="() => { handoffGuess = !handoffGuess; if (handoffGuess) handoffCoin = false; }">@T["Setup_HandoffGuess"]</button>
                <button class="chip @(handoffCoin ? "on" : "")" aria-pressed="@(handoffCoin ? "true" : "false")" @onclick="() => { handoffCoin = !handoffCoin; if (handoffCoin) handoffGuess = false; }">@T["Setup_HandoffCoin"]</button>
            </div>
            <p class="muted small">@T["Setup_HandoffExtrasHint"]</p>
        </section>
        }
    }

    @if (!PicksInLobby && !stories)
    {
    <section class="stack">
        <h2 class="label">@T["Setup_Decks"]</h2>
        @* Only decks with cards everyone at the table can read. *@
        @foreach (var deck in decks.Where(d => Readable(d) > 0))
        {
            var on = deckIds.Contains(deck.Id);
            <button class="check-row @(on ? "on" : "")" aria-pressed="@(on ? "true" : "false")" @onclick="() => Toggle(deckIds, deck.Id)">
                <span class="box @(on ? "on" : "")" aria-hidden="true">@if (on) { <Icon Name="check" Size="14" Stroke="3" /> }</span>
                <DeckBadge Style="deck.Style" />
                <span class="grow">
                    <span class="row-title">@deck.NameFor(Text.UiLang)</span>
                    <span class="muted small">@T.Plural("Cards", Readable(deck))</span>
                </span>
            </button>
        }
    </section>

    @if (Questions)
    {
    <section class="stack">
        <h2 class="label">@T["Setup_Order"]</h2>
        <div class="two" role="group" aria-label="@T["Setup_Order"]">
            <OptionCard Selected="@(order == CardOrder.LightToDeep)" OnSelect="() => order = CardOrder.LightToDeep"
                        Title="@T["Setup_OrderRamp"]" Description="@T["Setup_OrderRampDesc"]" />
            <OptionCard Selected="@(order == CardOrder.Shuffled)" OnSelect="() => order = CardOrder.Shuffled"
                        Title="@T["Setup_OrderShuffled"]" Description="@T["Setup_OrderShuffledDesc"]" />
        </div>
    </section>
    }
    }


    @if (!PicksInLobby && !Facts)
    {
    <section class="stack">
        <h2 class="label">@T["Setup_CardCount"]</h2>
        <div class="chips">
            @foreach (var count in new[] { 10, 20, 30 })
            {
                var c = count;
                <button class="chip @(cardCount == c ? "on" : "")" aria-pressed="@(cardCount == c ? "true" : "false")" @onclick="() => cardCount = c">@c</button>
            }
        </div>
    </section>
    }
</main>

<footer class="foot">
    <p class="muted center" role="status">@Summary</p>
    <button class="btn" disabled="@(!CanStart || busy)" @onclick="Start">@(Online ? T["Setup_CreateRoom"] : T["Setup_Start"])</button>
</footer>

@code {
    private const int MaxPlayers = 8;

    /// <summary>True when creating an online room: only your own name; everyone joins from their phone.</summary>
    [SupplyParameterFromQuery] public bool Online { get; set; }

    private string Title => Online ? T["Online_NewRoom"] : T["Setup_Title"];
    private bool busy;
    private string? createError;

    private sealed class PlayerRow
    {
        public string Id { get; } = Guid.NewGuid().ToString("N")[..8];
        public string Name { get; set; } = "";
        public Lang Lang { get; set; } = Text.UiLang;
    }

    private List<PlayerRow> players = [];
    private ImmutableArray<Deck> decks = [];
    private HashSet<string> deckIds = [];
    private AnswerMode mode = AnswerMode.Written;
    private TurnStyle turnStyle = TurnStyle.Everyone;
    private bool passThePhone;
    /// <summary>Blitz: 60-second hot-seat turns of quick association cards (see Pages/Blitz.razor).</summary>
    private bool blitz;
    /// <summary>Fill-in stories: Blind (words first) or Live (read along); see Pages/StoryGame.razor.</summary>
    private bool stories;
    /// <summary>"Give it to…": secretly hand the phone to someone, who guesses why; see Pages/HandoffGame.razor.</summary>
    private bool handoff;
    private bool handoffSecret = true;
    // One extra at most: a coin that hides the reason right after a guess would waste the guess.
    private bool handoffGuess = true;
    private bool handoffCoin;

    /// <summary>The fact games, on one phone or online: "One truth" and "Whose fact?".</summary>
    private bool oneTruth;
    private bool whoseFact;
    private bool trueOrFalse;
    private bool findTheLie;
    private int factsEach = 1;
    private bool revealEach = true;
    private bool Facts => oneTruth || whoseFact || trueOrFalse;

    private FactSettings? FactChoice => oneTruth ? new FactSettings(FactGameKind.OneTruth, findTheLie)
        : whoseFact ? new FactSettings(FactGameKind.WhoseFact, FactsEach: factsEach, RevealEachFact: revealEach)
        : trueOrFalse ? new FactSettings(FactGameKind.TrueOrFalse, FactsEach: factsEach)
        : null;

    /// <summary>The questions game: out loud or with secret answers (passThePhone), and always online.</summary>
    private bool Questions => !blitz && !stories && !handoff && !Facts;

    private string GameId => blitz ? "blitz" : stories ? "stories" : handoff ? "handoff" : oneTruth ? "onetruth" : whoseFact ? "whosefact" : trueOrFalse ? "trueorfalse" : "questions";

    /// <summary>One phone has every game; online has the games where everyone uses their own phone.</summary>
    private IEnumerable<(string Id, string Icon, string Label)> GameChoices => Online
        ? [("questions", "chat", "Setup_Questions"), ("onetruth", "idea", "Facts_OneTruth"), ("whosefact", "people", "Facts_WhoseFact"),
           ("trueorfalse", "check", "Facts_TrueOrFalse")]
        : [("questions", "chat", "Setup_Questions"), ("blitz", "bolt", "Setup_Blitz"), ("stories", "book", "Setup_Stories"),
           ("handoff", "secret", "Setup_Handoff"), ("onetruth", "idea", "Facts_OneTruth"), ("whosefact", "people", "Facts_WhoseFact"),
           ("trueorfalse", "check", "Facts_TrueOrFalse")];

    private void PickMode(string which)
    {
        blitz = which == "blitz";
        stories = which == "stories";
        handoff = which == "handoff";
        oneTruth = which == "onetruth";
        whoseFact = which == "whosefact";
        trueOrFalse = which == "trueorfalse";
        // A deck picked for one game is no use in another.
        deckIds.RemoveWhere(id => decks.FirstOrDefault(d => d.Id == id)?.Style != ModeStyle);
        // "Give it to…" needs three players; add the rows so the placeholders can play.
        while (handoff && players.Count < Handoffs.MinPlayers) players.Add(new PlayerRow());
        while (whoseFact && !Online && players.Count < FactGame.MinPlayers(FactGameKind.WhoseFact)) players.Add(new PlayerRow());
    }

    /// <summary>The kind of deck the chosen game plays.</summary>
    private DeckStyle ModeStyle => blitz ? DeckStyle.Blitz : handoff ? DeckStyle.Handoff : Facts ? DeckStyle.Facts : DeckStyle.Questions;
    private bool storyBlind = true;
    private bool storyLong;
    private string storyTheme = "random";

    /// <summary>Theme chips; the server picks a different premise from the chip's group for every story.</summary>
    private static readonly string[] StoryThemes = ["random", "travel", "love", "work", "family", "fairy"];
    private bool loadFailed;
    private int cardCount = 20;
    private CardOrder order = CardOrder.LightToDeep;
    private DeckSource source = DeckSource.Topics;
    private readonly HashSet<int> depths = [1, 2, 3];

    /// <summary>Players pick topics or bring decks in the lobby, so no decks, order or card count are chosen here.</summary>
    private bool PicksInLobby => Online && Questions && source != DeckSource.Chosen;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            decks = await Content.GetDecksAsync();
        }
        catch (ContentUnavailableException)
        {
            loadFailed = true;
        }
        deckIds = []; // nothing is selected until you pick (a previous game's choice is restored below)

        if (Session.LastSetup is { } last)
        {
            // A placeholder name from last time ("Player 2") stays a placeholder, not a typed name.
            players = last.Players.Select((p, i) => new PlayerRow { Name = p.Name == T["Setup_PlayerN", i + 1] ? "" : p.Name, Lang = p.Lang }).ToList();
            deckIds = last.DeckIds.Where(id => decks.Any(d => d.Id == id)).ToHashSet();
            mode = last.Settings.AnswerMode == AnswerMode.OutLoud ? AnswerMode.Written : last.Settings.AnswerMode;
            turnStyle = last.Settings.TurnStyle;
            passThePhone = last.PassThePhone;
            cardCount = last.Settings.CardCount;
            order = last.Settings.Order;
        }
        else
        {
            players = [new PlayerRow(), new PlayerRow()];
        }

        if (Online && await JS.InvokeAsync<string?>("mingle.get", "mingle.name") is { Length: > 0 } savedName && string.IsNullOrWhiteSpace(players[0].Name))
            players[0].Name = savedName;
    }

    /// <summary>
    /// The players: online, only a typed name counts (others see it); on one phone an empty row plays under its
    /// placeholder name, so nobody has to type names to start.
    /// </summary>
    private ImmutableArray<Player> NamedPlayers => Online
        ? [.. players.Where(p => !string.IsNullOrWhiteSpace(p.Name)).Select(p => new Player(p.Id, p.Name.Trim(), p.Lang))]
        : [.. players.Select(p => new Player(p.Id, string.IsNullOrWhiteSpace(p.Name) ? DefaultName(p) : p.Name.Trim(), p.Lang))];

    private string DefaultName(PlayerRow row) => T["Setup_PlayerN", players.IndexOf(row) + 1];

    private GameSettings Settings => new()
    {
        // Playing chosen decks means playing their cards: every card type and depth is included.
        // The game still starts light and goes deeper as it goes on.
        AnswerMode = Online || passThePhone ? mode : AnswerMode.OutLoud,
        // Out loud nothing is collected, so the card simply names whose turn it is.
        TurnStyle = Online || passThePhone ? turnStyle : TurnStyle.TakeTurns,
        CardCount = cardCount,
        Order = order,
    };

    private string HowToPlayLine
    {
        get
        {
            var parts = new List<string>();
            if (oneTruth) parts.Add(T[Online ? "Facts_OneTruthOnlineLine" : "Facts_OneTruthLine"]);
            else if (trueOrFalse) parts.Add(T[Online ? "Facts_TrueOrFalseOnlineLine" : "Facts_TrueOrFalseLine"]);
            else if (whoseFact) parts.Add(T[Online ? "Facts_WhoseFactLine" : "Facts_WhoseFactLocalLine"]);
            else if (!Online) parts.Add(stories ? T["Setup_StoriesLine"] : handoff ? T[handoffSecret ? "Setup_HandoffLine" : "Setup_HandoffAloudLine"] : blitz ? T["Setup_BlitzLine", Blitz.TurnSeconds] : passThePhone ? T["Setup_PassLine"] : T["Setup_OutLoudLine"]);
            if (Questions && (Online || passThePhone))
            {
                parts.Add(mode == AnswerMode.Written ? T["Setup_WriteLine"] : T["Setup_TalkLine"]);
                parts.Add(turnStyle == TurnStyle.Everyone ? T["Setup_AllLine"] : T["Setup_TurnsLine"]);
            }
            return string.Join(" · ", parts);
        }
    }

    /// <summary>The languages at the table: every player's on one phone; online, the host's for now.</summary>
    private Lang[] TableLanguages => Online ? [Text.UiLang] : [.. players.Select(p => p.Lang).Distinct()];

    /// <summary>Cards in a deck everyone can read: blitz lists only blitz decks, other games only question decks.</summary>
    /// <remarks>Blitz shows each player cards in their own language, so a card counts if any player reads it.</remarks>
    private int Readable(Deck deck) => deck.Cards.IsEmpty || deck.Style != ModeStyle ? 0
        : blitz || Facts ? deck.Cards.Count(c => TableLanguages.Any(c.Supports))
        : handoff ? deck.CountReadableBy(TableLanguages, CardKinds.OfStyle(DeckStyle.Handoff))
        : deck.CountReadableBy(TableLanguages);

    private int MatchingCards => blitz || handoff || Facts
        ? decks.Where(d => deckIds.Contains(d.Id)).Sum(Readable)
        :
        Game.BuildPool(decks.Where(d => deckIds.Contains(d.Id)), Settings, NamedPlayers.IsEmpty ? [new Player("x", "x", Text.UiLang)] : NamedPlayers).Length;

    private int NeededPlayers => Online ? 1 : handoff ? Handoffs.MinPlayers : oneTruth || trueOrFalse ? FactGame.MinPlayers(FactGameKind.OneTruth) : whoseFact ? FactGame.MinPlayers(FactGameKind.WhoseFact) : Game.MinPlayers;

    private bool CanStart => NamedPlayers.Length >= NeededPlayers && (stories || (PicksInLobby ? !decks.IsEmpty : MatchingCards > 0));

    private string Summary =>
        loadFailed ? T["Setup_LoadFailed"]
        : createError is not null ? createError
        : NamedPlayers.Length < NeededPlayers ? (Online ? T["Setup_NeedName"] : handoff || whoseFact ? T["Setup_NeedThree"] : T["Setup_NeedPlayers"])
        : stories ? ""
        : PicksInLobby ? T[source == DeckSource.Topics ? "Setup_SourceTopicsSummary" : "Setup_SourceEveryoneSummary"]
        : deckIds.Count == 0 ? T["Setup_PickDeck"]
        : MatchingCards == 0 ? T["Setup_NoCards"]
        : T.Plural("Setup_Matches", MatchingCards);

    private void AddPlayer() => players.Add(new PlayerRow());

    private static void Toggle(HashSet<string> set, string id)
    {
        if (!set.Remove(id)) set.Add(id);
    }

    private async Task Start()
    {
        if (!CanStart) return;
        if (!Online)
        {
            if (stories)
            {
                StorySessions.Start(NamedPlayers.Select(p => p.Name), storyTheme, storyLong, storyBlind);
                Nav.NavigateTo("story");
                return;
            }
            if (handoff)
            {
                HandoffGames.Start(NamedPlayers, decks.Where(d => deckIds.Contains(d.Id)), handoffSecret, handoffGuess, handoffCoin, cardCount);
                Nav.NavigateTo("handoff");
                return;
            }
            if (Facts)
            {
                FactGames.Start(NamedPlayers, decks.Where(d => deckIds.Contains(d.Id)), FactChoice!);
                Nav.NavigateTo("facts");
                return;
            }
            if (blitz)
            {
                Blitzes.Start(NamedPlayers, [.. decks.Where(d => deckIds.Contains(d.Id))]);
                Nav.NavigateTo("blitz");
                return;
            }
            Session.Start(new SetupChoices(NamedPlayers, Settings, deckIds.ToImmutableHashSet(), passThePhone), decks);
            Nav.NavigateTo("play");
            return;
        }

        busy = true;
        createError = null;
        try
        {
            var me = NamedPlayers[0] with { Lang = Text.UiLang };
            await JS.InvokeVoidAsync("mingle.set", "mingle.name", me.Name);
            var factSettings = FactChoice;
            var room = await Rooms.CreateRoom(me.Name, me.Lang,
                new RoomSettings(Settings, [.. deckIds], factSettings is null ? source : DeckSource.Chosen, [.. depths.Order()], factSettings));
            Nav.NavigateTo($"room/{room.RoomCode}");
        }
        catch (Exception ex) when (ex is HttpRequestException or Microsoft.AspNetCore.SignalR.HubException or InvalidOperationException)
        {
            createError = T["Online_ConnectFailed"];
        }
        finally
        {
            busy = false;
        }
    }
}
