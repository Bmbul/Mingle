@page "/story"
@inject Text T
@inject StorySession Game
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@T["Setup_Stories"] · Mingle</PageTitle>

@if (!Game.Ready)
{
    <main class="main center-screen">
        <p class="muted">@T["Blitz_NotStarted"]</p>
        <a class="btn" href="setup">@T["Home_NewGame"]</a>
    </main>
}
else if (loading)
{
    <main class="main center-screen" role="status">
        <div class="spinner" aria-hidden="true"></div>
        <p class="h2 center">@T["Story_Writing"]</p>
    </main>
}
else if (story is null)
{
    <main class="main center-screen">
        <p class="muted center">@T["Story_Failed"]</p>
    </main>
    <footer class="foot">
        <button class="btn" @onclick="NewStory">@T["Story_TryAgain"]</button>
        <a class="btn2" href="">@T["End_Home"]</a>
    </footer>
}
else if (Game.Blind && gap < story.Gaps.Length)
{
    @* Blind: collect the words first, without the story. *@
    <header class="top spread">
        <span class="muted">@T["Story_WordOf", gap + 1, story.Gaps.Length]</span>
    </header>
    <main class="main center-screen">
        <p class="muted">@T["Story_SayA"]</p>
        <p class="story-hint">@story.Gaps[gap].Hint</p>
        <form class="stack story-entry" @onsubmit="AddWord">
            <input id="story-word" class="field" lang="@Text.UiLang.Code()" maxlength="40" autocomplete="off"
                   @bind="word" @bind:event="oninput" aria-label="@story.Gaps[gap].Hint" />
            <button class="btn" type="submit" disabled="@string.IsNullOrWhiteSpace(word)">@T["Story_Next"]</button>
        </form>
    </main>
}
else
{
    @* The story: in blind mode with the collected words highlighted; live, with the gaps shown as hints. *@
    <main class="main">
        <h1 class="h1">@story.Title</h1>
        @if (!Game.Blind)
        {
            <p class="muted small">@T["Story_LiveHint"]</p>
        }
        <p class="story-text" lang="@Text.UiLang.Code()">
            @foreach (var part in story.Parts)
            {
                if (!part.IsGap)
                {
                    @part.Text
                }
                else if (Game.Blind)
                {
                    <mark class="story-word">@Story.WordFor(part, words)</mark>
                }
                else
                {
                    @* Live: a returning word asks for the word said before, not a new one; an Armenian ending
                       ("-ի") is shown so the reader adds it to the word that was shouted. *@
                    <span class="story-gap @(part.Repeat ? "repeat" : "")" title="@part.Hint">@(part.Repeat ? $"↺ {T["Story_SameWord"]}" : part.Hint)@if (part.Ending is { } ending)
                    {<span class="gap-ending">-@ending</span>}</span>
                }
            }
        </p>
        @if (note is not null)
        {
            <p class="muted small" role="status">@note</p>
        }
    </main>
    <footer class="foot">
        @if (Game.Blind)
        {
            <button class="btn2" @onclick="Share"><Icon Name="save" Size="18" />@T["Story_Share"]</button>
        }
        <button class="btn" @onclick="NewStory">@T["Story_New"]</button>
    </footer>
}

@code {
    private bool loading = true;
    private Story? story;
    private int gap;
    private string word = "";
    private List<string> words = [];
    private string? note;

    protected override async Task OnInitializedAsync()
    {
        if (Game.Ready) await NewStory();
    }

    private async Task NewStory()
    {
        loading = true;
        note = null;
        StateHasChanged();
        try { (story, _) = await Game.NextStoryAsync(); }
        catch (HttpRequestException) { story = null; }
        gap = 0;
        words = [];
        word = "";
        loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Keep the keyboard up between words.
        if (Game.Blind && story is not null && gap < story.Gaps.Length && !loading)
            await JS.InvokeVoidAsync("mingle.focus", "story-word");
    }

    private void AddWord()
    {
        if (string.IsNullOrWhiteSpace(word) || story is null) return;
        words.Add(word.Trim());
        word = "";
        gap++;
    }

    private async Task Share()
    {
        if (story is null) return;
        var result = await JS.InvokeAsync<string>("mingle.shareText", $"{story.Title}\n\n{story.Fill(words)}");
        note = result == "copied" ? T["Story_Copied"] : null;
    }
}
