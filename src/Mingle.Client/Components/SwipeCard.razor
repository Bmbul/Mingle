@implements IAsyncDisposable
@inject IJSRuntime JS

@*
    A card you swipe instead of tapping a button (js/cardswipe.js): it follows the finger any way, and a swipe in any
    direction does the same thing, usually "next card". A short drag springs back.
*@
@* A deck: the card in the middle of the screen with two more peeking out behind it, so it looks swipeable. *@
<div class="swipe-deck">
    <div class="swipe-stack">
        <div class="swipe-card" @ref="element" data-enabled="@Flag">
            @ChildContent
        </div>
    </div>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>What a swipe does, whichever way it goes.</summary>
    [Parameter] public EventCallback OnSwipe { get; set; }

    private ElementReference element;
    private DotNetObjectReference<SwipeCard>? self;
    private IJSObjectReference? handle;

    private string Flag => OnSwipe.HasDelegate ? "true" : "false";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        self = DotNetObjectReference.Create(this);
        // An old cached page without js/cardswipe.js keeps working: the card just can't be swiped until it reloads.
        try { handle = await JS.InvokeAsync<IJSObjectReference>("mingleCards.attach", element, self); }
        catch (JSException) { handle = null; }
    }

    [JSInvokable]
    public Task Swiped() => OnSwipe.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (handle is not null)
            {
                await handle.InvokeVoidAsync("detach");
                await handle.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { }
        self?.Dispose();
    }
}
