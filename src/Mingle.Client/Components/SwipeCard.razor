@implements IAsyncDisposable
@inject IJSRuntime JS

@*
    A card you swipe instead of tapping a button (js/cardswipe.js): it follows the finger any way, and a swipe in any
    direction does the same thing, usually "next card". A short drag springs back.
*@
@* A deck: the card in the middle of the screen with two more peeking out behind it, so it looks swipeable. *@
<div class="swipe-deck">
    <div class="swipe-stack @(Next is null ? "" : "has-next") @(Last ? "last" : "")">
        @if (Next is not null)
        {
            @* The next card, under the top one, so a swipe uncovers it. *@
            <div class="swipe-next" aria-hidden="true">@Next</div>
        }
        <div class="swipe-card" @ref="element" data-enabled="@Flag" data-mode="@(Sides ? "sides" : "any")">
            @ChildContent
        </div>
    </div>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>The card underneath (the next one); without it, the back of a card shows.</summary>
    [Parameter] public RenderFragment? Next { get; set; }
    /// <summary>The last card: nothing underneath.</summary>
    [Parameter] public bool Last { get; set; }
    /// <summary>What a swipe does, whichever way it goes.</summary>
    [Parameter] public EventCallback OnSwipe { get; set; }
    /// <summary>When set, only left and right count, each with its own meaning (Blitz: right = got it, left = skip).</summary>
    [Parameter] public EventCallback OnLeft { get; set; }
    [Parameter] public EventCallback OnRight { get; set; }

    private bool Sides => OnLeft.HasDelegate || OnRight.HasDelegate;

    private ElementReference element;
    private DotNetObjectReference<SwipeCard>? self;
    private IJSObjectReference? handle;

    private string Flag => OnSwipe.HasDelegate || Sides ? "true" : "false";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        self = DotNetObjectReference.Create(this);
        // An old cached page without js/cardswipe.js keeps working: the card just can't be swiped until it reloads.
        try { handle = await JS.InvokeAsync<IJSObjectReference>("mingleCards.attach", element, self); }
        catch (JSException) { handle = null; }
    }

    [JSInvokable]
    public Task Swiped(string side) =>
        !Sides ? OnSwipe.InvokeAsync()
        : side == "right" ? OnRight.InvokeAsync()
        : side == "left" ? OnLeft.InvokeAsync()
        : Task.CompletedTask;

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (handle is not null)
            {
                await handle.InvokeVoidAsync("detach");
                await handle.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { }
        self?.Dispose();
    }
}
