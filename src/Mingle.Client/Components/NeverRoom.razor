@inject Text T
@inject RoomClient Rooms

@* «Ես երբեք…» in an online room: answer in secret, see how many have, guess who. *@
@{
    var view = Never;
}

@if (view.Stage != NeverStage.Ended)
{
    <header class="top spread">
        <span class="muted">@T["Facts_ItemOf", view.Number, view.Count]</span>
        <button class="text-btn" aria-expanded="@(confirmEnd ? "true" : "false")" @onclick="() => confirmEnd = !confirmEnd">@T["Play_End"]</button>
    </header>
    @if (confirmEnd)
    {
        <div class="confirm" role="alertdialog" aria-labelledby="confirm-end-title">
            <span id="confirm-end-title" class="h2">@T["Play_EndConfirm"]</span>
            <div class="row gap">
                <button class="btn2 grow" @onclick="() => confirmEnd = false">@T["Play_KeepPlaying"]</button>
                <button class="btn grow" @onclick="EndNow">@T["Play_End"]</button>
            </div>
        </div>
    }
    <main class="main">
        @* Once the answer is out, swipe the card to go on. *@
        <SwipeCard OnSwipe="@((view.Stage == NeverStage.Revealed) ? EventCallback.Factory.Create(this, Rooms.NextNever) : default)" Last="@(view.Number >= view.Count)">
            <div class="card-face swipe-panel">
                <div class="card-face">
                    <p class="kind">@T[$"Never_Depth_{view.Depth}"]</p>
                    <p class="prompt">@view.Statement</p>
                </div>

                @if (view.Stage == NeverStage.Answering)
                {
                    <p class="muted small center">@T[view.Pair ? "Never_PairSecret" : "Never_Secret"]</p>
                    <div class="handoff-players">
                        <button class="btn2 @(view.MyAnswer == true ? "on" : "")" aria-pressed="@(view.MyAnswer == true ? "true" : "false")" @onclick="() => Rooms.AnswerNever(true)">@T["Never_IHave"]</button>
                        <button class="btn2 @(view.MyAnswer == false ? "on" : "")" aria-pressed="@(view.MyAnswer == false ? "true" : "false")" @onclick="() => Rooms.AnswerNever(false)">@T["Never_IHaveNot"]</button>
                    </div>
                    @* With two players a count would give the answer away: guess the other's answer instead. *@
                    @if (view.Pair && Other is { } other)
                    {
                        var guessed = view.GuessedIds.Contains(Room.YouId);
                        var saysHas = guessed && view.MyPicks.Contains(other.Id);
                        <h2 class="label center">@PlayerSlot.Fill(T["Never_PairGuess"], Text.UiLang, other.Name)</h2>
                        <div class="handoff-players">
                            <button class="btn2 @(saysHas ? "on" : "")" aria-pressed="@(saysHas ? "true" : "false")" @onclick="() => Rooms.GuessNever([other.Id])">@T["Never_PairHas"]</button>
                            <button class="btn2 @(guessed && !saysHas ? "on" : "")" aria-pressed="@(guessed && !saysHas ? "true" : "false")" @onclick="() => Rooms.GuessNever([])">@T["Never_PairHasNot"]</button>
                        </div>
                    }
                    <p class="muted small center" role="status">@T["Facts_Written", view.AnsweredIds.Length, Room.Players.Length]</p>
                }
                else if (view.Stage == NeverStage.Guessing)
                {
                    <p class="handoff-verdict right center">@T.Plural("Never_Have", view.HaveCount)</p>
                    @if (view.PicksNeeded > 0 && view.MyPicks.IsEmpty)
                    {
                        <h2 class="label">@T.Plural(view.MyAnswer == true ? "Never_PickOthers" : "Never_Pick", view.PicksNeeded)</h2>
                        <div class="handoff-players">
                            @foreach (var player in Room.Players.Where(p => p.Id != Room.YouId))
                            {
                                var id = player.Id;
                                var on = picked.Contains(id);
                                <button class="btn2 @(on ? "on" : "")" aria-pressed="@(on ? "true" : "false")" @onclick="() => Toggle(id, view.PicksNeeded)">@player.Name</button>
                            }
                        </div>
                        <button class="btn" disabled="@(picked.Count != view.PicksNeeded)" @onclick="SendPicks">@T["Guess_Send"]</button>
                    }
                    else
                    {
                        <div class="card waiting" role="status">
                            <span class="h2">@T["Online_WaitingOthers"]</span>
                            <span class="muted small">@T[view.PicksNeeded > 0 ? "Never_YourGuessIn" : "Never_NothingToGuess"]</span>
                        </div>
                    }
                }
                else
                {
                    <NeverResult HaveIds="view.HaveIds" Storyteller="@view.Storyteller" NameOf="NameOf" />
                    @if (view.Pair)
                    {
                        @foreach (var id in view.GuessedIds)
                        {
                            <p class="muted small center">@PlayerSlot.Fill(T[view.RightIds.Contains(id) ? "Never_PairRight" : "Never_PairWrong"], Text.UiLang, NameOf(id))</p>
                        }
                    }
                    else if (!view.MyPicks.IsEmpty)
                    {
                        <p class="muted small center">@T["Never_YouPicked", string.Join(", ", view.MyPicks.Select(id => NameOf(id) + (view.HaveIds.Contains(id) ? " ✓" : " ✗")))]</p>
                    }
                    <NeverScores Scores="view.Scores" NameOf="NameOf" />
                }
            </div>
        </SwipeCard>
    </main>
    <footer class="foot">
        @if (view.Stage != NeverStage.Revealed && Room.YouAreHost && (view.Stage == NeverStage.Guessing || view.AnsweredIds.Length > 0))
        {
            <button class="btn2" @onclick="Rooms.MoveNeverOn">@T[view.Stage == NeverStage.Answering && !view.Pair ? "Never_GuessNow" : "Facts_RevealNow"]</button>
        }
    </footer>
}
else
{
    <main class="main">
        <h1 class="h1 big">@T["End_Title"]</h1>
        <NeverScores Scores="view.Scores" NameOf="NameOf" Awards="true" />
    </main>
    <footer class="foot">
        <button class="btn" @onclick="OnHome">@T["End_Home"]</button>
    </footer>
}

@code {
    [Parameter, EditorRequired] public RoomView Room { get; set; } = default!;
    [Parameter, EditorRequired] public NeverView Never { get; set; } = default!;
    [Parameter] public EventCallback OnHome { get; set; }

    private bool confirmEnd;
    private readonly HashSet<string> picked = [];
    private int pickedFor = -1;

    protected override void OnParametersSet()
    {
        if (pickedFor != Never.Number)
        {
            pickedFor = Never.Number;
            picked.Clear();
        }
    }

    private void Toggle(string id, int max)
    {
        if (picked.Remove(id)) return;
        if (picked.Count >= max) return;
        picked.Add(id);
    }

    private Task SendPicks() => Rooms.GuessNever([.. picked]);

    private RoomPlayer? Other => Room.Players.FirstOrDefault(p => p.Id != Room.YouId);

    private string NameOf(string id) => Room.Players.FirstOrDefault(p => p.Id == id)?.Name ?? "?";

    private async Task EndNow()
    {
        confirmEnd = false;
        await Rooms.EndGame();
    }
}
