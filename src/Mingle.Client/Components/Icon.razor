<svg class="ic" width="@Size" height="@Size" viewBox="0 0 24 24" aria-hidden="true" style="stroke-width: @Stroke">
    @switch (Name)
    {
        case "back": <path d="M15 5l-7 7 7 7" /> break;
        case "close": <path d="M6 6l12 12M18 6L6 18" /> break;
        case "plus": <path d="M12 5v14M5 12h14" /> break;
        case "check": <path d="M5 12l5 5 9-10" /> break;
        case "pen": <path d="M4 20h4L19 9l-4-4L4 16zM13.5 6.5l4 4" /> break;
        case "chat": <path d="M4 5h16v11H9l-5 4z" /> break;
        case "people": <path d="M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM3 20c0-3.3 2.7-5 6-5s6 1.7 6 5M16 5a3 3 0 0 1 0 6M18 15c2 .6 3 2.3 3 5" /> break;
        case "layers": <path d="M12 4l9 5-9 5-9-5zM3 14l9 5 9-5" /> break;
        case "save": <path d="M5 4h11l3 3v13H5zM8 4v5h7V4M8 20v-6h8v6" /> break;
        case "speaker": <path d="M4 9v6h4l5 4V5L8 9zM16.5 9a4 4 0 0 1 0 6M19 6.5a8 8 0 0 1 0 11" /> break;
        case "pass": <path d="M6 3h8v18H6zM9 18h2M17 9h5M20 7l2 2-2 2M22 15h-5M19 13l-2 2 2 2" /> break;
        case "refresh": <path d="M20 11a8 8 0 1 0-2.3 5.7M20 4v7h-7" /> break;
        case "like": <path d="M7 11v9H4v-9zM7 11l4-7a2 2 0 0 1 3 2l-1 4h6a2 2 0 0 1 2 2.3l-1.2 6A2 2 0 0 1 17.8 20H7" /> break;
        case "dislike": <path d="M17 13V4h3v9zM17 13l-4 7a2 2 0 0 1-3-2l1-4H5a2 2 0 0 1-2-2.3l1.2-6A2 2 0 0 1 6.2 4H17" /> break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 24;
    [Parameter] public double Stroke { get; set; } = 1.8;
}
